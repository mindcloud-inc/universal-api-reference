        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "site",
                  "lang",
                  "content"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "site": {
                    "type": "string",
                    "description": "Target Ametys site name."
                  },
                  "lang": {
                    "type": "string",
                    "description": "Sitemap language where the page and content will be created."
                  },
                  "content": {
                    "type": "string",
                    "description": "XML content file using the Content IO import format."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "error": {
                            "type": "string",
                            "description": "Error message returned when the import fails."
                          },
                          "errors": {
                            "type": "string",
                            "description": "Error container returned by the XML ActionResult payload."
                          },
                          "success": {
                            "type": "boolean",
                            "description": "Whether the Content IO import completed successfully."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
