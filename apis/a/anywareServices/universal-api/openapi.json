    "/v1/universal/anywareServices/latest/actions/import-content-at-root": {
      "post": {
        "operationId": "anywareServices.import-content-at-root",
        "summary": "Import Content At Root",
        "description": "Creates a page and imported content at the site root in Anyware Services.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/anywareServices/latest/actions/import-content-at-root"
        },
