    "/v1/universal/agicap/latest/actions/list-bank-journal-exports": {
      "get": {
        "operationId": "agicap.list-bank-journal-exports",
        "summary": "List Bank Journal Exports",
        "description": "Retrieves previous bank journal exports from Agicap.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/agicap/latest/actions/list-bank-journal-exports"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityId",
            "in": "query",
            "required": true,
            "description": "Agicap entity identifier.",
            "schema": {
              "type": "string",
              "description": "Agicap entity identifier.",
              "example": "140010"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Number of exports to return. Agicap documents a maximum of 100.",
            "schema": {
              "type": "number",
              "description": "Number of exports to return. Agicap documents a maximum of 100.",
              "example": 100,
              "default": 100
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Return exports after this ISO 8601 date cursor or filter value.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Return exports after this ISO 8601 date cursor or filter value.",
              "example": "2026-01-01T00:00:00Z",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Return exports before this ISO 8601 date cursor or filter value.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Return exports before this ISO 8601 date cursor or filter value.",
              "example": "2026-12-31T23:59:59Z",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "exportDateUtc": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Export date-time in UTC."
                          },
                          "exportId": {
                            "type": "string",
                            "description": "Unique ID of the bank journal export."
                          },
                          "exportIndexInYear": {
                            "type": "number",
                            "description": "Index of the bank journal export in the export year."
                          },
                          "exportYear": {
                            "type": "number",
                            "description": "Year the export was done."
                          },
                          "indexInYearOfFirstEntryInBankJournal": {
                            "type": "number",
                            "description": "Index in export year of the first entry in this bank journal export."
                          },
                          "indexInYearOfLastEntryInBankJournal": {
                            "type": "number",
                            "description": "Index in export year of the last entry in this bank journal export."
                          },
                          "numberOfEntries": {
                            "type": "number",
                            "description": "Number of entries in the bank journal export."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
