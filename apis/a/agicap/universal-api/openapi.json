    "title": "Agicap Universal API",
    "version": "0.0.4",
    "description": "Agicap is a cash flow, treasury, payments, accounts payable, and accounts receivable platform. Its public API supports Treasury Bank Journal exports and organization entity lookup."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
