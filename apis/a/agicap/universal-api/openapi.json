  "paths": {
    "/v1/universal/agicap/latest/actions/create-bank-journal-export": {
      "post": {
        "operationId": "agicap.create-bank-journal-export",
        "summary": "Create Bank Journal Export",
        "description": "Creates a bank journal export in Agicap for ready-to-export entries.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/agicap/latest/actions/create-bank-journal-export"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "entityId",
                  "exportId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "entityId": {
                    "type": "string",
                    "description": "Agicap entity identifier.",
                    "example": "140010"
                  },
                  "exportId": {
                    "type": "string",
                    "description": "Caller-generated UUID for the export.",
                    "example": "47a62f3d-6885-4f33-a7d2-40a4470b3a5f"
                  },
                  "currentExportCounts.currentBankJournalsCountInYear": {
                    "type": "number",
                    "description": "Optional number of bank journals already created this year outside Agicap, for first export numbering continuity.",
                    "example": 0,
                    "x-mindcloud-advanced": true
                  },
                  "currentExportCounts.currentBankJournalEntriesCountInYear": {
                    "type": "number",
                    "description": "Optional number of bank journal entries already created this year outside Agicap, for first export numbering continuity.",
                    "example": 0,
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bankJournalExportIndexInYear": {
                            "type": "number",
                            "description": "Index of the bank journal export in the current year."
                          },
                          "entityName": {
                            "type": "string",
                            "description": "Name of the entity."
                          },
                          "entries": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Bank journal entries included in the export when the API returns a 200 response."
                          },
                          "exportId": {
                            "type": "string",
                            "description": "Identifier of the export."
                          },
                          "year": {
                            "type": "number",
                            "description": "UTC year when the bank journal was exported."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
