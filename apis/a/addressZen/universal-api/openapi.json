  "paths": {
    "/v1/universal/addressZen/latest/actions/email-validation": {
      "get": {
        "operationId": "addressZen.email-validation",
        "summary": "Email Validation",
        "description": "Retrieves email validation details from AddressZen.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/addressZen/latest/actions/email-validation"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Email address to validate",
            "schema": {
              "type": "string",
              "description": "Email address to validate",
              "example": "test@example.com"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "catchall": {
                            "type": "boolean",
                            "description": "Whether the domain is catch-all"
                          },
                          "deliverable": {
                            "type": "boolean",
                            "description": "Whether the email appears deliverable"
                          },
                          "disposable": {
                            "type": "boolean",
                            "description": "Whether the address appears disposable"
                          },
                          "free": {
                            "type": "boolean",
                            "description": "Whether the address uses a free provider"
                          },
                          "result": {
                            "type": "string",
                            "description": "Email deliverability classification"
                          },
                          "role": {
                            "type": "boolean",
                            "description": "Whether the address appears role-based"
                          },
                          "suggestions": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Suggested alternate email values"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/addressZen/latest/actions/phone-number-validation": {
      "get": {
        "operationId": "addressZen.phone-number-validation",
        "summary": "Phone Number Validation",
        "description": "Retrieves phone number validation details from AddressZen.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/addressZen/latest/actions/phone-number-validation"
        },
        "security": [
