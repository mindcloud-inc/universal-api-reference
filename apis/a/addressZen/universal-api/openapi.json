{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "AddressZen Universal API",
    "version": "0.0.15",
    "description": "AddressZen: Search, verify, and standardize addresses"
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/addressZen/latest"
  },
  "security": [
    {
      "bearerAuth": []
