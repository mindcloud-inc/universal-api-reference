                          },
                          "nationalFormat": {
                            "type": "string"
                          },
                          "originalCarrier": {
                            "type": "object",
                            "properties": {
                              "country": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "networkCode": {
                                "type": "string"
                              },
                              "networkType": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          },
                          "valid": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
