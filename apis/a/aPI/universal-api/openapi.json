        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vatNumber",
            "in": "query",
            "required": true,
            "description": "VAT number with or without country prefix.",
            "schema": {
              "type": "string",
              "description": "VAT number with or without country prefix."
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "required": true,
            "description": "ISO 2-letter country code.",
