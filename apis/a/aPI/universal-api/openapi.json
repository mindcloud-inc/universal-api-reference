                          },
                          "countryCode": {
                            "type": "string"
                          },
                          "valid": {
                            "type": "boolean"
                          },
                          "vatNumber": {
                            "type": "string"
                          },
                          "verificationDate": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
