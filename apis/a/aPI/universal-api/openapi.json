    "/v1/universal/aPI/latest/actions/validate-vat-number": {
      "get": {
        "operationId": "aPI.validate-vat-number",
        "summary": "Validate VAT Number",
        "description": "Validates a VAT number with 44API and returns company details.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/aPI/latest/actions/validate-vat-number"
        },
        "security": [
          {
            "bearerAuth": []
