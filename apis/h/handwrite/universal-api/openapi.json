                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "message": {
                    "type": "string",
                    "description": "Letter body text. Handwrite documents a maximum of 320 characters."
                  },
                  "handwriting": {
                    "type": "string",
                    "description": "The handwriting ID to use for the letter."
                  },
                  "card": {
                    "type": "string",
                    "description": "The stationery or card ID to use for the letter."
                  },
                  "recipients[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Array of recipient objects. Each recipient should include address fields such as firstName, lastName, street1, city, state, and zip."
                  },
                  "from": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional return-address object with firstName, lastName, street1, street2, city, state, and zip."
