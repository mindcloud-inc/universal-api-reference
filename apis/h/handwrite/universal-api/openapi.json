    "/v1/universal/handwrite/latest/actions/send-letter": {
      "post": {
        "operationId": "handwrite.send-letter",
        "summary": "Send Letter",
        "description": "Sends a handwritten letter through Handwrite.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/handwrite/latest/actions/send-letter"
        },
        "security": [
          {
            "bearerAuth": []
