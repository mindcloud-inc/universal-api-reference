                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "number",
                                "description": "The identifier of the created Lnk."
                              },
                              "url": {
                                "type": "string",
                                "description": "The public Lnk.Bio profile URL."
                              }
                            },
                            "additionalProperties": false
                          },
                          "errors": {
