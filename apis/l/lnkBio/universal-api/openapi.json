          "url": "https://mindcloud.co/docs/universal/rest/lnkBio/latest/actions/create-lnk"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "title",
                  "link"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "title": {
                    "type": "string",
                    "description": "The title shown for the Lnk on your public Lnk.Bio profile."
                  },
                  "link": {
                    "type": "string",
                    "description": "The destination URL for the new Lnk."
                  },
                  "image": {
                    "type": "string",
                    "description": "Optional image URL for the Lnk."
                  },
                  "groupId": {
                    "type": "number",
                    "description": "Optional Lnk.Bio group identifier for the new Lnk."
                  },
                  "scheduleFrom": {
                    "type": "string",
                    "description": "Optional RFC3339 timestamp for when the Lnk should become active."
                  },
                  "scheduleTo": {
                    "type": "string",
                    "description": "Optional RFC3339 timestamp for when the Lnk should stop being active."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
