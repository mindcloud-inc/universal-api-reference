    "/v1/universal/logRocket/latest/actions/update-user-information": {
      "put": {
        "operationId": "logRocket.update-user-information",
        "summary": "Update User Information",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/logRocket/latest/actions/update-user-information"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "userId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "userId": {
                    "type": "string",
                    "description": "The LogRocket user ID to create or update."
                  },
                  "name": {
                    "type": "string",
                    "description": "Optional user name. LogRocket allows up to 1024 characters."
                  },
                  "email": {
                    "type": "string",
                    "description": "Optional user email. LogRocket allows up to 1024 characters.",
                    "example": "user@example.com"
                  },
                  "timestamp": {
                    "type": "number",
                    "description": "Optional Unix timestamp in milliseconds for the submitted user data.",
                    "x-mindcloud-advanced": true
                  },
                  "traits": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional object of user trait names and values.",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "email": {
                            "type": "string",
                            "description": "User email"
                          },
                          "name": {
                            "type": "string",
                            "description": "User name"
                          },
                          "traits": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Stored user traits"
                          },
                          "userID": {
                            "type": "string",
                            "description": "LogRocket user ID"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
