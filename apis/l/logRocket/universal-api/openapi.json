{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "LogRocket Universal API",
    "version": "0.1.4",
    "description": "LogRocket provides session replay, product analytics, issue tracking, and Galileo AI summaries for web and mobile application behavior."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/logRocket/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/logRocket/latest/actions/get-highlights-result": {
      "get": {
        "operationId": "logRocket.get-highlights-result",
        "summary": "Get Highlights Result",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/logRocket/latest/actions/get-highlights-result"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The highlights request ID returned by Request User Highlights.",
            "schema": {
              "type": "string",
              "description": "The highlights request ID returned by Request User Highlights.",
              "example": "highlights request id"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "appID": {
                            "type": "string",
                            "description": "LogRocket app ID in org/project form"
                          },
                          "requestID": {
                            "type": "string",
                            "description": "Highlights request ID"
                          },
                          "result": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Highlights result payload when ready",
                            "properties": {
                              "highlights": {
                                "type": "string",
                                "description": "Markdown summary across included sessions"
                              },
                              "sessions": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "highlights": {
                                      "type": "string",
                                      "description": "Markdown session highlights"
                                    },
                                    "recordingID": {
                                      "type": "string",
                                      "description": "LogRocket recording ID"
                                    },
                                    "sessionID": {
                                      "type": "number",
                                      "description": "Session ID"
                                    }
                                  }
                                },
                                "description": "Per-session highlight summaries"
                              }
                            }
                          },
                          "status": {
                            "type": "string",
                            "description": "Generation status such as PENDING, READY, or FAILED"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/logRocket/latest/actions/request-user-highlights": {
      "post": {
        "operationId": "logRocket.request-user-highlights",
        "summary": "Request User Highlights",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/logRocket/latest/actions/request-user-highlights"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "userEmail": {
                    "type": "string",
                    "description": "Email of a user identified in LogRocket. Either User Email or User ID is required by LogRocket.",
                    "example": "user@example.com"
                  },
                  "userID": {
                    "type": "string",
                    "description": "ID of a user identified in LogRocket. Either User Email or User ID is required by LogRocket."
                  },
                  "question": {
                    "type": "string",
                    "description": "Optional question for Galileo to answer about the selected sessions.",
                    "x-mindcloud-advanced": true
                  },
                  "timeRange": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional object with startMs and endMs epoch millisecond values.",
                    "x-mindcloud-advanced": true
                  },
                  "webhookURL": {
                    "type": "string",
                    "description": "Optional URL where LogRocket should POST highlights when ready.",
                    "example": "https://example.com/webhook",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Highlights request ID used to retrieve results"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
