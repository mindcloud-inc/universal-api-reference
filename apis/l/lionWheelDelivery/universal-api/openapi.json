                "type": "object",
                "required": [
                  "connectionId",
                  "originalOrderId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "destinationPhone": {
                    "type": "string",
                    "description": "The destination recipient phone number."
                  },
                  "notes": {
                    "type": "string",
                    "description": "General delivery notes."
                  },
                  "originalOrderId": {
                    "type": "string",
                    "description": "Your external order ID for the task."
                  },
