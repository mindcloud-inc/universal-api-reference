    "/v1/universal/lionWheelDelivery/latest/actions/update-task": {
      "put": {
        "operationId": "lionWheelDelivery.update-task",
        "summary": "Update Task",
        "description": "Updates an existing task in LionWheel Delivery.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/lionWheelDelivery/latest/actions/update-task"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "taskId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "pickupAt": {
                    "type": "string",
                    "description": "Pickup date for the task."
                  },
                  "taskId": {
                    "type": "string",
                    "description": "The LionWheel task ID."
                  },
                  "status": {
                    "type": "number",
                    "description": "Task status code: UNASSIGNED=0, ASSIGNED=1, ACTIVE=2, COMPLETED=3, CANCELED=4, ROUNDTRIP_DELIVERED=5, FAILED=8."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
