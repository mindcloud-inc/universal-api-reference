                            "type": "string",
                            "description": "Destination region when available."
                          },
                          "label": {
                            "type": "string",
                            "description": "Printable label URL."
                          },
                          "originalOrderId": {
                            "type": "string",
                            "description": "External order ID supplied on create."
                          },
                          "publicId": {
                            "type": "string",
                            "description": "Public identifier for the created task."
                          },
                          "taskId": {
                            "type": "number",
                            "description": "Created LionWheel task ID."
                          },
                          "trackingLink": {
                            "type": "string",
                            "description": "Tracking URL for the created task."
