  "info": {
    "title": "Leverly Universal API",
    "version": "0.0.3",
    "description": "Send leads to Leverly and stop queued calls"
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/leverly/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
