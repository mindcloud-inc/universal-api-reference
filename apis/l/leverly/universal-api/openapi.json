  "paths": {
    "/v1/universal/leverly/latest/actions/create-call": {
      "post": {
        "operationId": "leverly.create-call",
        "summary": "Create Call",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/leverly/latest/actions/create-call"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "firstName",
                  "phone1"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "address1": {
                    "type": "string",
                    "description": "Lead's address."
                  },
                  "area": {
                    "type": "string",
                    "description": "Lead's area of interest."
                  },
                  "callDelay": {
                    "type": "number",
                    "description": "Delay before the initial call in seconds."
                  },
                  "callerId": {
                    "type": "string",
                    "description": "Caller ID to display on leg 1 of the call."
                  },
                  "city": {
                    "type": "string",
                    "description": "Lead's city."
                  },
                  "comments": {
                    "type": "string",
                    "description": "Lead comments."
                  },
                  "companyName": {
                    "type": "string",
                    "description": "Lead's company name."
                  },
                  "email": {
                    "type": "string",
                    "description": "Lead's email address."
                  },
                  "keyword": {
                    "type": "string",
                    "description": "Lead's keyword."
                  },
                  "lastName": {
                    "type": "string",
                    "description": "Lead's last name."
                  },
                  "leadSource": {
                    "type": "string",
                    "description": "Lead's source."
                  },
                  "location": {
                    "type": "string",
                    "description": "Lead's location."
                  },
                  "phone2": {
                    "type": "string",
                    "description": "Lead's second phone number."
                  },
                  "phone3": {
                    "type": "string",
                    "description": "Lead's third phone number."
                  },
                  "phone4": {
                    "type": "string",
                    "description": "Lead's fourth phone number."
                  },
                  "program": {
                    "type": "string",
                    "description": "Lead's program of interest."
                  },
                  "repPhone": {
                    "type": "string",
                    "description": "Representative phone number. Separate multiple numbers with commas."
                  },
                  "routingType": {
                    "type": "number",
                    "description": "1 = Step ringing, 2 = Round robin, 3 = Simultaneous."
                  },
                  "state": {
                    "type": "string",
                    "description": "Lead's state."
                  },
                  "vendorLeadId": {
                    "type": "string",
                    "description": "Vendor lead identifier used to reconcile and stop a submitted call later."
                  },
                  "zip": {
                    "type": "string",
                    "description": "Lead's ZIP code."
                  },
                  "firstName": {
                    "type": "string",
                    "description": "Lead's first name."
                  },
                  "phone1": {
                    "type": "string",
                    "description": "Lead's primary phone number."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "inquiryId": {
                            "type": "number",
                            "description": "Leverly inquiry identifier for the submitted lead."
                          },
                          "message": {
                            "type": "string",
                            "description": "Human-readable result message returned by Leverly."
                          },
                          "status": {
                            "type": "string",
                            "description": "Result status returned by Leverly."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
