            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Start date in ISO format (YYYY-MM-DD).",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Start date in ISO format (YYYY-MM-DD).",
              "example": "2026-03-27"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "End date in ISO format (YYYY-MM-DD).",
