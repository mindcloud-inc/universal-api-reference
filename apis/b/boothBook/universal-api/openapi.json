    "title": "BoothBook Universal API",
    "version": "0.0.5",
    "description": "BoothBook is an event-booking platform for booth and event businesses. This draft wrapper exposes the currently documented BoothBook developer API for account and booking reads and remains blocked on live BoothBook API ingress verification."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/boothBook/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
