        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "media",
            "in": "query",
            "required": true,
            "description": "One or more requested native media formats. Bunnies.io returns matching media URLs plus a poster.",
            "schema": {
              "type": "string",
              "description": "One or more requested native media formats. Bunnies.io returns matching media URLs plus a poster. Pass multiple values separated by `,`.",
              "enum": [
                "0",
                "1",
                "2",
                "3"
              ]
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
