          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Native Bunnies.io bunny identifier."
                          },
                          "media": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Native media URL object. It preserves selected gif, mp4, av1, or webm URL keys plus poster; no media flattening or URL reconstruction is applied."
                          },
                          "source": {
                            "type": "string",
                            "description": "Provider-supplied original media-source URL or native source marker."
                          },
                          "thisServed": {
                            "type": "number",
                            "description": "Provider current serving counter."
                          },
                          "totalServed": {
                            "type": "number",
                            "description": "Provider total serving counter."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
