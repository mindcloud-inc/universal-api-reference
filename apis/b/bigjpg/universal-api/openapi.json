            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "taskIds",
            "in": "query",
            "required": true,
            "description": "One or more Bigjpg task IDs, comma-separated in the request path.",
            "schema": {
              "type": "string",
              "description": "One or more Bigjpg task IDs, comma-separated in the request path. Pass multiple values separated by `,`.",
              "example": "tid1,tid2"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
