    "/v1/universal/bigjpg/latest/actions/retry-task": {
      "put": {
        "operationId": "bigjpg.retry-task",
        "summary": "Retry Task",
        "description": "Retries image enlargement tasks in Bigjpg by task ID.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/bigjpg/latest/actions/retry-task"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "taskIds"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "taskIds": {
                    "type": "string",
                    "description": "One or more Bigjpg task IDs to retry, comma-separated in the request path. Pass multiple values separated by `,`.",
                    "example": "tid1,tid2"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
