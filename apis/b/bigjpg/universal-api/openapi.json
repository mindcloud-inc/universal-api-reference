{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Bigjpg Universal API",
    "version": "0.0.3",
    "description": "Bigjpg is an AI image upscaling service for enlarging images while reducing noise and preserving detail."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/bigjpg/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/bigjpg/latest/actions/create-enlarge-task": {
      "post": {
        "operationId": "bigjpg.create-enlarge-task",
        "summary": "Create Enlarge Task",
        "description": "Creates an image enlargement task in Bigjpg.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/bigjpg/latest/actions/create-enlarge-task"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "input",
                  "style",
                  "noise",
                  "x2"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "input": {
                    "type": "string",
                    "description": "Public URL of the image to enlarge.",
                    "example": "https://example.com/image.jpg"
                  },
                  "style": {
                    "type": "string",
                    "description": "Bigjpg image style: art for illustrations or photo for photographs.",
                    "enum": [
                      "art",
                      "photo"
                    ],
                    "default": "art"
                  },
                  "noise": {
                    "type": "string",
                    "description": "Noise reduction level documented by Bigjpg.",
                    "enum": [
                      "-1",
                      "0",
                      "1",
                      "2",
                      "3"
                    ],
                    "default": "3"
                  },
                  "x2": {
                    "type": "string",
                    "description": "Upscale factor selector documented by Bigjpg.",
                    "enum": [
                      "1",
                      "2",
                      "3",
                      "4"
                    ],
                    "default": "1"
                  },
                  "fileName": {
                    "type": "string",
                    "description": "Optional file name from the Bigjpg Python example.",
                    "example": "small.jpg",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "description": "Bigjpg task creation status or business gating message."
                          },
                          "tid": {
                            "type": "string",
                            "description": "Bigjpg task ID returned when an enlarge task is accepted."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/bigjpg/latest/actions/get-task-result": {
      "get": {
        "operationId": "bigjpg.get-task-result",
        "summary": "Get Task Result",
        "description": "Retrieves task results from Bigjpg by task ID.",
        "externalDocs": {
