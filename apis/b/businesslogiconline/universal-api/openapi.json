    "/v1/universal/businesslogiconline/latest/actions/describe-calculator": {
      "get": {
        "operationId": "businesslogiconline.describe-calculator",
        "summary": "Describe Calculator",
        "description": "Retrieves calculator input and output schemas from Businesslogic.online.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/businesslogiconline/latest/actions/describe-calculator"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "available_data": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Provider-supplied object describing any extra available calculator data."
                          },
                          "expected_input": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "JSON Schema describing the calculator input payload."
                          },
                          "expected_output": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "JSON Schema describing the calculator output payload."
                          },
                          "name": {
                            "type": "string",
                            "description": "Calculator name returned by the describe endpoint."
                          },
                          "version": {
                            "type": "string",
                            "description": "Calculator version returned by the describe endpoint."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
