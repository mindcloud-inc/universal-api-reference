    "/v1/universal/businesslogiconline/latest/actions/execute-calculator": {
      "post": {
        "operationId": "businesslogiconline.execute-calculator",
        "summary": "Execute Calculator",
        "description": "Executes a calculator with input values in Businesslogic.online.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/businesslogiconline/latest/actions/execute-calculator"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "inputValue": {
                    "type": "number",
                    "description": "Numeric input passed to the Businesslogic calculator."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "doubled_value": {
                            "type": "number",
                            "description": "Calculated output returned by the execute endpoint."
                          }
