  "paths": {
    "/v1/universal/beatovenAI/latest/actions/compose-track": {
      "post": {
        "operationId": "beatovenAI.compose-track",
        "summary": "Compose Track",
        "description": "Starts track composition in Beatoven AI from a text prompt.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/beatovenAI/latest/actions/compose-track"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "prompt.text"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "prompt.text": {
                    "type": "string",
                    "description": "Text prompt describing the track you want Beatoven to compose.",
                    "default": "5 seconds soft piano note"
                  },
                  "format": {
                    "type": "string",
                    "description": "Audio format for the generated track. Supported values are mp3, aac, and wav.",
                    "enum": [
                      "0",
                      "1",
                      "2"
                    ],
                    "default": "wav"
                  },
                  "looping": {
                    "type": "boolean",
                    "description": "Set to true to increase looping in the generated track.",
                    "default": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string"
                          },
                          "task_id": {
                            "type": "string"
                          },
                          "track_id": {
                            "type": "string"
                          },
                          "version": {
                            "type": "number"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
