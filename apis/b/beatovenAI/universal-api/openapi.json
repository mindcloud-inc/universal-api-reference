  "info": {
    "title": "Beatoven AI Universal API",
    "version": "0.0.4",
    "description": "Beatoven AI lets you generate AI music tracks from text prompts and check composition task status through Beatoven's public API."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
