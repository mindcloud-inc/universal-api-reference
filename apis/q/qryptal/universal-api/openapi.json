                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "payload": {
                    "type": "string",
                    "description": "JSON string containing the Qryptal payload with data, format, and scheme.",
                    "example": "[object Object]"
                  },
