              "description": "Unique Qryptal identifier returned when the QR code was created.",
              "example": "1097580178100010000601672116"
            }
          },
          {
            "name": "codeToken",
            "in": "query",
            "required": true,
            "description": "The code_token value returned by QR creation.",
