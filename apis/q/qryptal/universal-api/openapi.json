                            "description": "Creation timestamp returned by Qryptal."
                          },
                          "id": {
                            "type": "number",
                            "description": "Qryptal internal record identifier."
                          },
                          "msg": {
                            "type": "string",
                            "description": "Human-readable Qryptal status message."
                          },
                          "qrText": {
                            "type": "string",
                            "description": "Raw QR payload text returned by Qryptal."
                          },
                          "qrurl": {
                            "type": "string",
                            "description": "Direct URL for downloading the generated QR image."
                          },
                          "scheme": {
                            "type": "string",
                            "description": "QR scheme returned by Qryptal."
                          },
                          "status": {
                            "type": "string",
                            "description": "Creation status code such as P, C, or E."
                          },
                          "uid": {
                            "type": "string",
                            "description": "Stable Qryptal unique identifier for the created code."
                          },
                          "vqtype": {
                            "type": "string",
                            "description": "Qryptal code type, for example PDC or TEDC."
