              "type": "number",
              "description": "Set to 0 to request a transparent background.",
              "example": 0,
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Optional image size selector documented by Qryptal.",
