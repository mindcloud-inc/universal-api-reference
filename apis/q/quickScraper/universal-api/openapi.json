    "/v1/universal/quickScraper/latest/actions/get-account-info": {
      "get": {
        "operationId": "quickScraper.get-account-info",
        "summary": "Get Account Info",
        "description": "Retrieves account details from Quick Scraper.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/quickScraper/latest/actions/get-account-info"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "allocatedCredits": {
                            "type": "number",
                            "description": "Monthly credit allocation for the current Quick Scraper account."
                          },
                          "allowedConcurrentRequests": {
                            "type": "number",
                            "description": "Maximum concurrent requests allowed for the account."
                          },
                          "currentConcurrentRequests": {
                            "type": "number",
                            "description": "Concurrent requests currently in use."
                          },
                          "failedRequests": {
                            "type": "number",
                            "description": "Failed requests recorded for the current period."
                          },
                          "remainingCredits": {
                            "type": "number",
                            "description": "Credits still available in the current period."
                          },
                          "subscriptionExpiryDate": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Subscription expiry timestamp returned by Quick Scraper."
                          },
                          "successRequests": {
                            "type": "number",
                            "description": "Successful requests recorded for the current period."
                          },
                          "usedCredits": {
                            "type": "number",
                            "description": "Credits already consumed in the current period."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
