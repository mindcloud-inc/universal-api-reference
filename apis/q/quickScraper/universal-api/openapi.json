            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "The public page URL Quick Scraper should fetch and return.",
            "schema": {
              "type": "string",
              "description": "The public page URL Quick Scraper should fetch and return.",
              "example": "https://example.com",
              "default": "https://example.com"
            }
