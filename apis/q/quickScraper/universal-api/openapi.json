  "info": {
    "title": "Quick Scraper Universal API",
    "version": "0.0.7",
    "description": "Extract webpage HTML and parser-backed data through Quick Scraper's proxy-backed scraping API."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
