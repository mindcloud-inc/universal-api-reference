  "info": {
    "title": "Dpd2 Universal API",
    "version": "0.0.2",
    "description": "Access your DPD account data, including storefronts, products, purchases, subscribers, and customers, with support for purchase reactivation."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
