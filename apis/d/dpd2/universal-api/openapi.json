    "/v1/universal/dpd2/latest/actions/get-product": {
      "get": {
        "operationId": "dpd2.get-product",
        "summary": "Get Product",
        "description": "Retrieves a product from DPD by ID.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/dpd2/latest/actions/get-product"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Unique product ID.",
            "schema": {
              "type": "number",
              "description": "Unique product ID."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "created_at": {
                            "type": "string",
                            "description": "Product creation timestamp as returned by DPD."
                          },
                          "description": {
                            "type": "string",
                            "description": "Short product description."
                          },
                          "file_name": {
                            "type": "string",
                            "description": "Uploaded file name, if present."
                          },
                          "file_size": {
                            "type": "number",
                            "description": "Uploaded file size in bytes, if present."
                          },
                          "id": {
                            "type": "number",
                            "description": "Unique product ID."
                          },
                          "image_file_name": {
                            "type": "string",
                            "description": "Uploaded image file name, if present."
                          },
                          "image_updated_at": {
                            "type": "string",
                            "description": "Image updated timestamp, if present."
                          },
                          "long_description": {
                            "type": "string",
                            "description": "Long product description."
                          },
                          "mime_type": {
                            "type": "string",
                            "description": "Uploaded file MIME type, if present."
                          },
                          "name": {
                            "type": "string",
                            "description": "Product name."
                          },
                          "price": {
                            "type": "string",
                            "description": "Default product price."
                          },
                          "prices": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Per-price option records."
                          },
                          "sku": {
                            "type": "string",
                            "description": "Product SKU."
                          },
                          "storefront_id": {
                            "type": "number",
                            "description": "Owning storefront ID."
                          },
                          "updated_at": {
                            "type": "string",
                            "description": "Product update timestamp as returned by DPD, or null."
                          },
                          "visibility": {
                            "type": "number",
                            "description": "Visibility flag where 1 means displayed."
                          },
                          "weight": {
                            "type": "number",
                            "description": "Product weight, if present."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
