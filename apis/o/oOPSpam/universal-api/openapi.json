    "/v1/universal/oOPSpam/latest/actions/report-misdetection": {
      "post": {
        "operationId": "oOPSpam.report-misdetection",
        "summary": "Report Misdetection",
        "description": "Reports a false positive or false negative to OOPSpam.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/oOPSpam/latest/actions/report-misdetection"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "shouldBeSpam"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "content": {
                    "type": "string",
                    "description": "Message content that was misclassified."
                  },
                  "senderIP": {
                    "type": "string",
                    "description": "IP address of the original sender."
                  },
                  "email": {
                    "type": "string",
                    "description": "Email address of the original sender."
                  },
                  "checkForLength": {
                    "type": "boolean",
                    "description": "Treat very short content as spam.",
                    "default": true
                  },
                  "blockTempEmail": {
                    "type": "boolean",
                    "description": "Block disposable email addresses.",
                    "default": false
                  },
                  "logIt": {
                    "type": "boolean",
                    "description": "Send this request to OOPSpam dashboard logs.",
                    "default": false
                  },
                  "source": {
                    "type": "string",
                    "description": "Unique source identifier required when logIt is true."
                  },
                  "shouldBeSpam": {
                    "type": "boolean",
                    "description": "Whether the submission should have been classified as spam."
                  },
                  "context": {
                    "type": "string",
                    "description": "Business or website context used for contextual detection."
                  },
                  "blockVPN": {
                    "type": "boolean",
                    "description": "Block VPN, proxy, and Tor IPs.",
                    "default": false
                  },
                  "blockDC": {
                    "type": "boolean",
                    "description": "Block cloud provider and data center IPs.",
                    "default": false
                  },
                  "urlFriendly": {
                    "type": "boolean",
                    "description": "Reduce the impact of links on the spam score.",
                    "default": false
                  },
                  "allowedLanguages[]": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Two-letter language codes that are allowed."
                  },
                  "allowedCountries[]": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Two-letter country codes that are allowed."
                  },
                  "blockedCountries[]": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Two-letter country codes that are blocked."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "message": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
