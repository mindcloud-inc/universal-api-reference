                      "network": "ethereum sepolia testnet",
                      "technology": "ethereum"
                    }
                  },
                  "callbackUrl": {
                    "type": "string",
                    "description": "Public callback URL that Overledger will send webhook events to."
                  },
                  "smartContractId": {
                    "type": "string",
                    "description": "Smart contract identifier/address to monitor."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
