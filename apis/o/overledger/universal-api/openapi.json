                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "location": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Overledger location object with technology and network.",
