              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "callbackUrl": {
                            "type": "string",
                            "description": "Callback URL."
                          },
                          "callbackUrlStatus": {
                            "type": "string",
                            "description": "Callback URL status."
                          },
                          "location": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Blockchain location."
                          },
                          "smartContractId": {
                            "type": "string",
                            "description": "Monitored smart contract identifier."
                          },
                          "webhookId": {
                            "type": "string",
                            "description": "Created webhook identifier."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
