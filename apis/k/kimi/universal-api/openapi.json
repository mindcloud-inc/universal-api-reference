                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "contextLength": {
                            "type": "number",
                            "description": "Maximum context length."
                          },
                          "created": {
                            "type": "number",
                            "description": "Model creation timestamp."
                          },
                          "id": {
                            "type": "string",
                            "description": "Model ID."
                          },
                          "object": {
                            "type": "string",
                            "description": "Object type, usually model."
                          },
                          "ownedBy": {
                            "type": "string",
                            "description": "Model owner."
                          },
                          "parent": {
                            "type": "string",
                            "description": "Parent model identifier when provided."
                          },
                          "permission": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Permission metadata for the model."
                          },
                          "root": {
                            "type": "string",
                            "description": "Root model identifier when provided."
                          },
                          "supportsImageIn": {
                            "type": "boolean",
                            "description": "Whether the model supports image input."
                          },
                          "supportsReasoning": {
                            "type": "boolean",
                            "description": "Whether the model supports reasoning."
                          },
                          "supportsVideoIn": {
                            "type": "boolean",
                            "description": "Whether the model supports video input."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
