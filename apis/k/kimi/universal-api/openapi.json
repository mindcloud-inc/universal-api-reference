                          },
                          "data": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Balance information.",
                            "properties": {
                              "availableBalance": {
                                "type": "number",
                                "description": "Available balance."
                              },
                              "cashBalance": {
                                "type": "number",
                                "description": "Cash balance."
                              },
                              "voucherBalance": {
                                "type": "number",
                                "description": "Voucher balance."
                              }
                            }
                          },
                          "scode": {
                            "type": "string",
                            "description": "Provider status code."
                          },
                          "status": {
                            "type": "boolean",
                            "description": "Whether the balance request succeeded."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
