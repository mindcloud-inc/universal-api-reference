    "/v1/universal/kimi/latest/actions/list-models": {
      "get": {
        "operationId": "kimi.list-models",
        "summary": "List Models",
        "description": "Retrieves the available models from Kimi.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/kimi/latest/actions/list-models"
        },
        "security": [
          {
            "bearerAuth": []
