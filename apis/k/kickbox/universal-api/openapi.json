    "/v1/universal/kickbox/latest/actions/verify-email": {
      "get": {
        "operationId": "kickbox.verify-email",
        "summary": "Verify Email",
        "description": "Verifies an email address with Kickbox.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/kickbox/latest/actions/verify-email"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "The email address to verify, URL-encoded.",
            "schema": {
              "type": "string",
              "description": "The email address to verify, URL-encoded."
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "description": "Maximum time in milliseconds for the verification request. Default 6000, maximum 30000.",
            "schema": {
              "type": "number",
              "description": "Maximum time in milliseconds for the verification request. Default 6000, maximum 30000."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "accept_all": {
                            "type": "boolean",
                            "description": "Whether the domain appears configured as accept-all."
                          },
                          "did_you_mean": {
                            "type": "string",
                            "description": "Suggested correction for a likely typo in the email address."
                          },
                          "disposable": {
                            "type": "boolean",
                            "description": "Whether the address appears disposable or temporary."
                          },
                          "domain": {
                            "type": "string",
                            "description": "Domain portion of the email address."
                          },
                          "email": {
                            "type": "string",
                            "description": "Normalized email address returned by Kickbox."
                          },
                          "free": {
                            "type": "boolean",
                            "description": "Whether the address belongs to a free email provider."
                          },
                          "message": {
                            "type": "string",
                            "description": "Provider message returned with the verification result."
                          },
                          "reason": {
                            "type": "string",
                            "description": "Specific reason associated with the verification outcome."
                          },
                          "result": {
                            "type": "string",
                            "description": "Top-level verification outcome for the email address."
                          },
                          "role": {
                            "type": "boolean",
                            "description": "Whether the address appears to be a role account."
                          },
                          "sendex": {
                            "type": "number",
                            "description": "Kickbox Sendex quality score for the email address."
                          },
                          "success": {
                            "type": "boolean",
                            "description": "Whether the verification request succeeded."
                          },
                          "user": {
                            "type": "string",
                            "description": "Local-part user portion of the email address."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
