      "get": {
        "operationId": "zohoSurvey.get-oauth-user-info",
        "summary": "Get OAuth User Info",
        "description": "Retrieves connected Zoho account user info for Zoho Survey.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/zohoSurvey/latest/actions/get-oauth-user-info"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
