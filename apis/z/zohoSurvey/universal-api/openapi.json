                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Display_Name": {
                            "type": "string",
                            "description": "Zoho display name from the OAuth user info response."
                          },
                          "Email": {
                            "type": "string",
                            "description": "Zoho email address from the OAuth user info response."
                          },
                          "First_Name": {
                            "type": "string",
                            "description": "Zoho first name from the OAuth user info response."
                          },
                          "Last_Name": {
                            "type": "string",
                            "description": "Zoho last name from the OAuth user info response."
                          },
                          "ZUID": {
                            "type": "number",
                            "description": "Zoho user identifier from the OAuth user info response."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
