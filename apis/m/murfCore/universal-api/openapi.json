    "/v1/universal/murfCore/latest/actions/list-voices": {
      "get": {
        "operationId": "murfCore.list-voices",
        "summary": "List Voices",
        "description": "Retrieves available voices from Murf Core.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/murfCore/latest/actions/list-voices"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Optional Murf voice model filter. Valid values are FALCON or GEN2.",
            "schema": {
              "type": "string",
              "description": "Optional Murf voice model filter. Valid values are FALCON or GEN2."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
