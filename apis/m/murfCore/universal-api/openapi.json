              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "accent": {
                            "type": "string",
                            "description": "Accent label returned by Murf."
                          },
                          "availableStyles": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Available speaking styles for the voice."
                          },
                          "description": {
                            "type": "string",
                            "description": "Age-range description for the voice."
                          },
                          "displayLanguage": {
                            "type": "string",
                            "description": "Display language for the voice."
                          },
                          "displayName": {
                            "type": "string",
                            "description": "Human-readable voice name."
                          },
                          "gender": {
                            "type": "string",
                            "description": "Voice gender."
                          },
                          "locale": {
                            "type": "string",
                            "description": "Primary locale for the voice."
                          },
                          "supportedLocales": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Map of supported locales and their styles."
                          },
                          "voiceId": {
                            "type": "string",
                            "description": "Unique Murf voice identifier."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
