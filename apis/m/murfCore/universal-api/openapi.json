    "/v1/universal/murfCore/latest/actions/voice-changer": {
      "post": {
        "operationId": "murfCore.voice-changer",
        "summary": "Voice Changer",
        "description": "Converts audio to another voice with Murf Core.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/murfCore/latest/actions/voice-changer"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "voiceId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "voiceId": {
                    "type": "string",
                    "description": "Target Murf voice ID for the converted audio."
                  },
                  "file": {
                    "type": "string",
                    "description": "Audio file to convert."
                  },
                  "fileUrl": {
                    "type": "string",
                    "description": "Public URL for the source audio file."
                  },
                  "format": {
                    "type": "string",
                    "description": "Output audio format."
                  },
                  "encodeOutputAsBase64": {
                    "type": "boolean",
                    "description": "Return the generated audio as base64 in the response."
                  },
                  "channelType": {
                    "type": "string",
                    "description": "Output channel type."
                  },
                  "sampleRate": {
                    "type": "number",
                    "description": "Output sample rate in hertz."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "audio_file": {
                            "type": "string",
                            "description": "URL for the converted audio file."
                          },
                          "audio_length_in_seconds": {
                            "type": "number",
                            "description": "Length of the converted audio in seconds."
                          },
                          "encoded_audio": {
                            "type": "string",
                            "description": "Base64-encoded converted audio when requested."
                          },
                          "remaining_character_count": {
                            "type": "number",
                            "description": "Remaining characters available after the conversion."
                          },
                          "warning": {
                            "type": "string",
                            "description": "Optional warning returned by Murf."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
