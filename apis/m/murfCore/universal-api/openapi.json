    "/v1/universal/murfCore/latest/actions/synthesize-speech": {
      "post": {
        "operationId": "murfCore.synthesize-speech",
        "summary": "Synthesize Speech",
        "description": "Synthesizes speech from text in Murf Core.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/murfCore/latest/actions/synthesize-speech"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "text",
                  "voiceId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "text": {
                    "type": "string",
                    "description": "The text to synthesize into speech."
                  },
                  "voiceId": {
                    "type": "string",
                    "description": "Voice identifier from the List Voices action."
                  },
                  "locale": {
                    "type": "string",
                    "description": "Optional target locale for multi-native generation."
                  },
                  "format": {
                    "type": "string",
                    "description": "Optional output format such as WAV, MP3, or FLAC."
                  },
                  "encodeAsBase64": {
                    "type": "boolean",
                    "description": "Return audio inline as base64 instead of a hosted URL."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "audioFile": {
                            "type": "string",
                            "description": "URL for the generated audio file."
                          },
                          "audioLengthInSeconds": {
                            "type": "number",
                            "description": "Length of the generated audio in seconds."
                          },
                          "consumedCharacterCount": {
                            "type": "number",
                            "description": "Characters consumed in the current billing cycle."
                          },
                          "encodedAudio": {
                            "type": "string",
                            "description": "Base64-encoded audio when requested."
                          },
                          "remainingCharacterCount": {
                            "type": "number",
                            "description": "Remaining characters available for synthesis in the current billing cycle."
                          },
                          "warning": {
                            "type": "string",
                            "description": "Optional warning returned by Murf."
                          },
                          "wordDurations": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Per-word timing metadata for the generated speech."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
