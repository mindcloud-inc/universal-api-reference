            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Required historical date or date range, such as 2026-04-30 or 2026-04-01,2026-04-30.",
