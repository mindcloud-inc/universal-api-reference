              "type": "string",
              "description": "One or more comma-separated source codes, such as abc-news. Prefix a source code with - to exclude it.",
              "example": "cnn,-bbc",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "description": "One or more comma-separated categories. Prefix a category with - to exclude it.",
            "schema": {
              "type": "string",
              "description": "One or more comma-separated categories. Prefix a category with - to exclude it.",
              "example": "business,-sports"
