                          "price": {
                            "type": "number"
                          },
                          "reward": {
                            "type": "number"
                          },
                          "reward_block": {
                            "type": "number"
                          },
                          "reward_unit": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "updated": {
                            "type": "number"
                          },
                          "volume": {
                            "type": "number"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
