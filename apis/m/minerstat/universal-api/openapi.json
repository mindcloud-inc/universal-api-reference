            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "list",
            "in": "query",
            "required": false,
            "description": "Comma-separated coin tickers like BTC,BCH,BSV.",
            "schema": {
              "type": "string",
              "description": "Comma-separated coin tickers like BTC,BCH,BSV.",
              "example": "BTC,BCH,BSV"
            }
          },
          {
            "name": "algo",
            "in": "query",
            "required": false,
            "description": "Comma-separated algorithms like SHA-256,Scrypt.",
            "schema": {
              "type": "string",
              "description": "Comma-separated algorithms like SHA-256,Scrypt.",
              "example": "SHA-256,Scrypt"
