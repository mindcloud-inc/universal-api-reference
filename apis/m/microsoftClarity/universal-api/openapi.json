            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numOfDays",
            "in": "query",
            "required": false,
            "description": "Number of days to export from the current time. Allowed values are 1, 2, or 3.",
            "schema": {
              "type": "number",
              "description": "Number of days to export from the current time. Allowed values are 1, 2, or 3.",
              "default": 1
            }
          },
          {
            "name": "dimension1",
            "in": "query",
            "required": false,
            "description": "The first dimension used to break down insights. Allowed values are Browser, Device, Country/Region, OS, Source, Medium, Campaign, Channel, or URL.",
