              "type": "string",
              "description": "The first dimension used to break down insights. Allowed values are Browser, Device, Country/Region, OS, Source, Medium, Campaign, Channel, or URL.",
              "enum": [
                "Browser",
                "Campaign",
                "Channel",
                "Country/Region",
                "Device",
                "Medium",
                "OS",
                "Source",
                "URL"
              ]
            }
          },
          {
            "name": "dimension2",
            "in": "query",
            "required": false,
            "description": "The second dimension used to break down insights. Allowed values are Browser, Device, Country/Region, OS, Source, Medium, Campaign, Channel, or URL.",
