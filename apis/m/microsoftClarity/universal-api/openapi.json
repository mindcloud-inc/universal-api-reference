  "info": {
    "title": "Microsoft Clarity Universal API",
    "version": "0.0.6",
    "description": "Export recent Microsoft Clarity dashboard insights for traffic, engagement, devices, browsers, URLs, and campaigns."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/microsoftClarity/latest"
  },
  "security": [
