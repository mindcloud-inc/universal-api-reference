            }
          },
          {
            "name": "dimension3",
            "in": "query",
            "required": false,
            "description": "The third dimension used to break down insights. Allowed values are Browser, Device, Country/Region, OS, Source, Medium, Campaign, Channel, or URL.",
            "schema": {
              "type": "string",
              "description": "The third dimension used to break down insights. Allowed values are Browser, Device, Country/Region, OS, Source, Medium, Campaign, Channel, or URL.",
              "enum": [
                "Browser",
                "Campaign",
                "Channel",
                "Country/Region",
                "Device",
                "Medium",
                "OS",
                "Source",
                "URL"
              ],
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
