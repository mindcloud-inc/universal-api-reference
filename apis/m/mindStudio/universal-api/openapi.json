                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "apps": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Apps visible to the current MindStudio API key."
                          },
