    "/v1/universal/mindStudio/latest/actions/generate-signed-access-url": {
      "post": {
        "operationId": "mindStudio.generate-signed-access-url",
        "summary": "Generate Signed Access URL",
        "description": "Creates a signed access URL for a MindStudio agent.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/mindStudio/latest/actions/generate-signed-access-url"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "agentId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "agentId": {
                    "type": "string",
                    "description": "The MindStudio agent ID to generate a signed access URL for."
                  },
                  "userId": {
                    "type": "string",
                    "description": "Optional unique user identifier for the signed access session."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "description": "The signed access URL for the requested agent."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
