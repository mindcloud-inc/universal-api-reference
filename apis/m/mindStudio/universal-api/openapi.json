    "/v1/universal/mindStudio/latest/actions/run-app": {
      "post": {
        "operationId": "mindStudio.run-app",
        "summary": "Run App",
        "description": "Runs an app in MindStudio.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/mindStudio/latest/actions/run-app"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "appId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "appId": {
                    "type": "string",
                    "description": "The MindStudio app ID to run."
                  },
                  "variables": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Variables to pass into the MindStudio app run."
                  },
                  "workflow": {
                    "type": "string",
                    "description": "Optional workflow to run within the app."
                  },
                  "callbackUrl": {
                    "type": "string",
                    "description": "Optional callback URL for asynchronous app runs."
                  },
                  "includeBillingCost": {
                    "type": "boolean",
                    "description": "Whether to include billing cost information in the response."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "billingCost": {
                            "type": "string",
                            "description": "Billing cost returned when requested."
                          },
                          "callbackInProgress": {
                            "type": "boolean",
                            "description": "Whether the run is continuing asynchronously via callback."
                          },
                          "result": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "The app result payload when the run completes synchronously."
                          },
                          "success": {
                            "type": "boolean",
                            "description": "Whether the callback-based run request was accepted."
                          },
                          "thread": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Thread details returned for the app run."
                          },
                          "threadId": {
                            "type": "string",
                            "description": "The thread ID created for the app run."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
