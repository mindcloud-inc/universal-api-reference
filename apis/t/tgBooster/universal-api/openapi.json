    "/v1/universal/tgBooster/latest/actions/list-campaigns": {
      "get": {
        "operationId": "tgBooster.list-campaigns",
        "summary": "List Campaigns",
        "description": "Retrieves campaigns from a specific TgBooster cabinet.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/tgBooster/latest/actions/list-campaigns"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cabinetId",
            "in": "query",
            "required": true,
            "description": "Cabinet ID returned by List Cabinets.",
            "schema": {
              "type": "number",
              "description": "Cabinet ID returned by List Cabinets.",
              "example": 242
            }
          },
          {
            "name": "filters[startDate]",
            "in": "query",
            "required": false,
            "description": "Start date for campaign statistics filtering.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Start date for campaign statistics filtering.",
              "example": "2023-03-01",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "filters[finishDate]",
            "in": "query",
            "required": false,
            "description": "Finish date for campaign statistics filtering.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Finish date for campaign statistics filtering.",
              "example": "2023-09-10",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ads_active_count": {
                            "type": "number",
                            "description": "Active ad count."
                          },
                          "ads_count": {
                            "type": "number",
                            "description": "Total ad count."
                          },
                          "ads_sum_budget": {
                            "type": "string",
                            "description": "Sum of ad budgets as returned by TgBooster."
                          },
                          "cabinet_id": {
                            "type": "number",
                            "description": "Parent cabinet ID."
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Campaign creation timestamp."
                          },
                          "id": {
                            "type": "number",
                            "description": "Campaign ID."
                          },
                          "name": {
                            "type": "string",
                            "description": "Campaign name."
                          },
                          "stat_clicks": {
                            "type": "string",
                            "description": "Campaign clicks statistic as returned by TgBooster."
                          },
                          "stat_joins": {
                            "type": "string",
                            "description": "Campaign joins statistic as returned by TgBooster."
                          },
                          "stat_spent": {
                            "type": "string",
                            "description": "Campaign spent statistic as returned by TgBooster."
                          },
                          "stat_views": {
                            "type": "string",
                            "description": "Campaign views statistic as returned by TgBooster."
                          },
                          "status_id": {
                            "type": "number",
                            "description": "Campaign status ID."
                          },
                          "status": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "number",
                                "description": "Nested status ID."
                              },
                              "indicator": {
                                "type": "string",
                                "description": "Nested status indicator."
                              },
                              "name": {
                                "type": "string",
                                "description": "Nested status label."
                              }
                            },
                            "additionalProperties": false
                          },
                          "system": {
                            "type": "number",
                            "description": "System campaign flag."
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Campaign update timestamp."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
