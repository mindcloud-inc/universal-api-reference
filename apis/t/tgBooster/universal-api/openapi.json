  "paths": {
    "/v1/universal/tgBooster/latest/actions/get-reports": {
      "get": {
        "operationId": "tgBooster.get-reports",
        "summary": "Get Reports",
        "description": "Retrieves custom campaign reports from a TgBooster cabinet.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/tgBooster/latest/actions/get-reports"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cabinetId",
            "in": "query",
            "required": true,
            "description": "Cabinet ID returned by List Cabinets.",
            "schema": {
              "type": "number",
              "description": "Cabinet ID returned by List Cabinets.",
              "example": 242
            }
          },
          {
            "name": "groups[date][day]",
            "in": "query",
            "required": false,
            "description": "Group report rows by day.",
            "schema": {
              "type": "boolean",
              "description": "Group report rows by day.",
              "default": true
            }
          },
          {
            "name": "groups[date][week]",
            "in": "query",
            "required": false,
            "description": "Group report rows by week.",
            "schema": {
              "type": "boolean",
              "description": "Group report rows by week.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "groups[ads][company]",
            "in": "query",
            "required": false,
            "description": "Group report rows by campaign.",
            "schema": {
              "type": "boolean",
              "description": "Group report rows by campaign."
            }
          },
          {
            "name": "groups[ads][ad]",
            "in": "query",
            "required": false,
            "description": "Group report rows by ad.",
            "schema": {
              "type": "boolean",
              "description": "Group report rows by ad.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "groups[ads][adUrl]",
            "in": "query",
            "required": false,
            "description": "Group report rows by ad URL.",
            "schema": {
              "type": "boolean",
              "description": "Group report rows by ad URL.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "filters[company][]",
            "in": "query",
            "required": false,
            "description": "Campaign IDs to include in the report.",
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Campaign IDs to include in the report.",
              "x-mindcloud-advanced": true
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "filters[dates][]",
            "in": "query",
            "required": false,
            "description": "Two report dates: start date and end date.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date-time"
              },
              "description": "Two report dates: start date and end date."
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "metrics[views]",
            "in": "query",
            "required": false,
            "description": "Include views metric.",
            "schema": {
              "type": "boolean",
              "description": "Include views metric.",
              "default": true
            }
          },
          {
            "name": "metrics[clicks]",
            "in": "query",
            "required": false,
            "description": "Include clicks metric.",
            "schema": {
              "type": "boolean",
              "description": "Include clicks metric.",
              "default": true
            }
          },
          {
            "name": "metrics[joins]",
            "in": "query",
            "required": false,
            "description": "Include joins metric.",
            "schema": {
              "type": "boolean",
              "description": "Include joins metric.",
              "default": true
            }
          },
          {
            "name": "metrics[spent]",
            "in": "query",
            "required": false,
            "description": "Include spent metric.",
            "schema": {
              "type": "boolean",
              "description": "Include spent metric.",
              "default": true
            }
          },
          {
            "name": "metrics[ctr]",
            "in": "query",
            "required": false,
            "description": "Include CTR metric.",
            "schema": {
              "type": "boolean",
              "description": "Include CTR metric.",
              "default": true
            }
          },
          {
            "name": "metrics[cv]",
            "in": "query",
            "required": false,
            "description": "Include conversion from views to joins.",
            "schema": {
              "type": "boolean",
              "description": "Include conversion from views to joins.",
              "default": true
            }
          },
          {
            "name": "metrics[cpc]",
            "in": "query",
            "required": false,
            "description": "Include CPC metric.",
            "schema": {
              "type": "boolean",
              "description": "Include CPC metric.",
              "default": true
            }
          },
          {
            "name": "metrics[cps]",
            "in": "query",
            "required": false,
            "description": "Include CPS metric.",
            "schema": {
              "type": "boolean",
              "description": "Include CPS metric.",
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date_day": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Report day when grouped by day."
                          },
                          "metric_clicks": {
                            "type": "string",
                            "description": "Clicks metric as returned by TgBooster."
                          },
                          "metric_cpc": {
                            "type": "number",
                            "description": "CPC metric."
                          },
                          "metric_cps": {
                            "type": "number",
                            "description": "CPS metric."
                          },
                          "metric_ctr": {
                            "type": "number",
                            "description": "CTR metric."
                          },
                          "metric_cv": {
                            "type": "number",
                            "description": "Conversion metric from views to joins."
                          },
                          "metric_joins": {
                            "type": "string",
                            "description": "Joins metric as returned by TgBooster."
                          },
                          "metric_spent": {
                            "type": "string",
                            "description": "Spent metric as returned by TgBooster."
                          },
                          "metric_views": {
                            "type": "string",
                            "description": "Views metric as returned by TgBooster."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
