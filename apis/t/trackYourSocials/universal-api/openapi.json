              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "comments": {
                            "type": "number"
                          },
                          "Likes": {
                            "type": "number"
                          },
                          "platform": {
                            "type": "string"
                          },
                          "post": {
                            "type": "string"
                          },
                          "success": {
                            "type": "boolean"
                          },
                          "thumbnail": {
                            "type": "string"
                          },
                          "views": {
                            "type": "number"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
