          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "n",
            "in": "query",
            "required": false,
            "description": "Number of posts to return. Supported range: 1 to 200.",
            "schema": {
              "type": "number",
              "description": "Number of posts to return. Supported range: 1 to 200.",
              "example": 10,
              "default": 10
            }
          },
          {
            "name": "userAccount",
            "in": "query",
            "required": true,
            "description": "Profile URL or handle for the social media account.",
            "schema": {
              "type": "string",
              "description": "Profile URL or handle for the social media account.",
              "example": "@handle (or full URL)"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
