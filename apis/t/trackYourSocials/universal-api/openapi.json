    "/v1/universal/trackYourSocials/latest/actions/get-post-analytics": {
      "get": {
        "operationId": "trackYourSocials.get-post-analytics",
        "summary": "Get Post Analytics",
        "description": "Retrieves engagement metrics for a social media post from TrackYourSocials.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/trackYourSocials/latest/actions/get-post-analytics"
        },
