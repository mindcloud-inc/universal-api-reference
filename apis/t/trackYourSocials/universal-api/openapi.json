        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaLink",
            "in": "query",
            "required": true,
            "description": "URL of the social media content to analyze.",
            "schema": {
              "type": "string",
              "description": "URL of the social media content to analyze.",
              "example": "https://instagram.com/p/ABC123"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
