                              },
                              "name": {
                                "type": "string"
                              },
                              "platform": {
                                "type": "string"
                              },
                              "posted_at": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "additionalProperties": false
                          },
                          "success": {
                            "type": "boolean"
