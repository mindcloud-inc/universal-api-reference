    "/v1/universal/trackYourSocials/latest/actions/list-last-n-posts": {
      "get": {
        "operationId": "trackYourSocials.list-last-n-posts",
        "summary": "List Last N Posts",
        "description": "Retrieves the last N posts from a social profile in TrackYourSocials.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/trackYourSocials/latest/actions/list-last-n-posts"
        },
