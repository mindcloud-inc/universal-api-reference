                              },
                              "csvCheckInReport": {
                                "type": "string"
                              },
                              "dashboard": {
                                "type": "string"
                              },
                              "designer": {
                                "type": "string"
                              },
                              "lookup": {
                                "type": "string"
                              },
                              "notCheckedInReport": {
                                "type": "string"
                              },
                              "pay": {
                                "type": "string"
                              },
                              "register": {
                                "type": "string"
                              },
                              "scanCountsReport": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
