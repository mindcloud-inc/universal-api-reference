    "/v1/universal/trakQrAutomation/latest/actions/create-attendee": {
      "post": {
        "operationId": "trakQrAutomation.create-attendee",
        "summary": "Create Attendee",
        "description": "Creates a new attendee for an event in Trak Qr Automation.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/trakQrAutomation/latest/actions/create-attendee"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "eventKey",
                  "attachments[]",
                  "attachments[].kind",
                  "attachments[].val"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "eventKey": {
                    "type": "string",
                    "description": "Generated event key returned by Create Event."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Optional comments on the attendee."
                  },
                  "attachments[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Attendee form data fields."
                  },
                  "attachments[].kind": {
                    "type": "string",
                    "description": "Attachment field name matching an event form field."
                  },
                  "attachments[].val": {
                    "type": "string",
                    "description": "Attachment field value. Trak accepts a number, string, or string array."
                  },
                  "attachments[].internal": {
                    "type": "boolean",
                    "description": "Set true for technical fields that should not be shown in the Trak UI.",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pdfUrl": {
                            "type": "string",
                            "description": "URL for downloading the PDF ticket. Append &inline=true to display it in browser."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
