    "/v1/universal/trakQrAutomation/latest/actions/create-event": {
      "post": {
        "operationId": "trakQrAutomation.create-event",
        "summary": "Create Event",
        "description": "Creates a new event in Trak Qr Automation.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/trakQrAutomation/latest/actions/create-event"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "title",
                  "eventId",
                  "formFields[]",
                  "formFields[].name",
                  "formFields[].editor"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "title": {
                    "type": "string",
                    "description": "Event user-facing name, used as app title in Trak."
                  },
                  "eventId": {
                    "type": "string",
                    "description": "Your internal event ID, used as correlation ID."
                  },
                  "formFields[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Schema of attendee attachment fields for this event."
                  },
                  "formFields[].name": {
                    "type": "string",
                    "description": "Field name used as label and report column header."
                  },
                  "formFields[].editor": {
                    "type": "string",
                    "description": "Field type: number, line, text, select, radios, or checkboxes.",
                    "enum": [
                      "0",
                      "1",
                      "2",
                      "3",
                      "4",
                      "5"
                    ]
                  },
                  "formFields[].values[]": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Allowed values for select, radios, and checkboxes fields."
                  },
                  "titleFormat": {
                    "type": "string",
                    "description": "Mini-template for ticket titles, such as {First name} {Last name}.",
                    "x-mindcloud-advanced": true
                  },
                  "logoUrl": {
                    "type": "string",
                    "description": "Optional PNG or JPG logo URL for tickets, ideally 300x300px with a white background.",
                    "x-mindcloud-advanced": true
                  },
                  "bgUrl": {
                    "type": "string",
                    "description": "Optional PNG or JPG ticket background URL, ideally 596x842px.",
                    "x-mindcloud-advanced": true
                  },
                  "creatorInfo": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional information about the form creator.",
                    "x-mindcloud-advanced": true
                  },
                  "creatorInfo.ip": {
                    "type": "string",
                    "description": "Creator IP address.",
                    "x-mindcloud-advanced": true
                  },
                  "creatorInfo.loc": {
                    "type": "string",
                    "description": "Creator country or town.",
                    "x-mindcloud-advanced": true
                  },
                  "creatorInfo.email": {
                    "type": "string",
                    "description": "Creator email used for support.",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
