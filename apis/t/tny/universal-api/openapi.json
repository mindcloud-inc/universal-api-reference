  "paths": {
    "/v1/universal/tny/latest/actions/bulk-create-short-links": {
      "post": {
        "operationId": "tny.bulk-create-short-links",
        "summary": "Bulk Create Short Links",
        "description": "Creates multiple shortened links in Tny.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/tny/latest/actions/bulk-create-short-links"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "links"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "links": {
                    "type": "string",
                    "description": "Array of link objects to create. Each item requires url and can include customSlug and domain_id."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "created": {
                            "type": "number",
                            "description": "Number of links created successfully."
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Per-item errors returned by Tny."
                          },
                          "failed": {
                            "type": "number",
                            "description": "Number of links that failed."
                          },
                          "results": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Created links returned by Tny."
                          },
                          "success": {
                            "type": "boolean",
                            "description": "Whether the bulk request was accepted."
                          },
                          "tier": {
                            "type": "string",
                            "description": "Plan tier reported by Tny."
                          },
                          "total": {
                            "type": "number",
                            "description": "Total links submitted in the batch."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
