    "/v1/universal/tny/latest/actions/list-links": {
      "get": {
        "operationId": "tny.list-links",
        "summary": "List Links",
        "description": "Retrieves short links from Tny.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/tny/latest/actions/list-links"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Return links for the current API key only or for all API keys on the account.",
            "schema": {
              "type": "string",
              "description": "Return links for the current API key only or for all API keys on the account.",
              "enum": [
                "all",
                "key"
              ],
              "default": "key"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of records to return.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of records to skip before returning results.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "clickCount": {
                            "type": "number",
                            "description": "Tracked click count for the link."
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the short link was created."
                          },
                          "customDomain": {
                            "type": "string",
                            "description": "Custom domain used by the link when present."
                          },
                          "id": {
                            "type": "string",
                            "description": "Short link slug identifier."
                          },
                          "longUrl": {
                            "type": "string",
                            "description": "Original destination URL."
                          },
                          "shortUrl": {
                            "type": "string",
                            "description": "Shortened URL."
                          }
                        },
                        "additionalProperties": false
                      }
