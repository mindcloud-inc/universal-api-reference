  "info": {
    "title": "Tny Universal API",
    "version": "0.0.4",
    "description": "API-first link shortener for creating short links, listing links, and retrieving link analytics."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
