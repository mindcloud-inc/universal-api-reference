    "/v1/universal/textingHouse/latest/actions/send-commercial-sms": {
      "post": {
        "operationId": "textingHouse.send-commercial-sms",
        "summary": "Send Commercial SMS",
        "description": "Creates a commercial SMS in TextingHouse.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/textingHouse/latest/actions/send-commercial-sms"
        },
