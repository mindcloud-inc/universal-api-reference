          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "to",
                  "txt"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "to": {
                    "type": "string",
                    "description": "Recipient phone number in international format, including country code.",
                    "example": "33628000000"
                  },
                  "txt": {
                    "type": "string",
                    "description": "SMS content to send.",
                    "example": "ACME: 20% off today. Reply STOP to opt out."
                  },
                  "climsgid": {
                    "type": "string",
                    "description": "Optional client-defined message identifier, up to 32 characters.",
                    "example": "FRS78913246",
                    "x-mindcloud-advanced": true
                  },
                  "from": {
                    "type": "string",
                    "description": "Optional sender ID approved on your TextingHouse account.",
                    "example": "MindCloud",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
