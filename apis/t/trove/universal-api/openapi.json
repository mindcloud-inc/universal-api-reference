                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "description": {
                    "type": "string",
                    "description": "The original transaction description previously sent to Enrich Transaction."
                  },
                  "domain": {
                    "type": "string",
