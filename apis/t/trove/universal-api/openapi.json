                            },
                            "description": "Business categories associated with the matched company."
                          },
                          "domain": {
                            "type": "string",
                            "description": "Company domain matched to the transaction."
                          },
                          "facebook_url": {
                            "type": "string",
                            "description": "Official Facebook URL."
                          },
                          "founded": {
                            "type": "string",
                            "description": "Company founding date or year."
                          },
                          "handle": {
                            "type": "string",
                            "description": "Trove company handle."
                          },
                          "hq_city": {
                            "type": "string",
                            "description": "Headquarters city."
                          },
                          "hq_country_code": {
                            "type": "string",
                            "description": "Country code returned by Trove. Docs say ISO alpha-2, but live responses currently return values like USA."
                          },
                          "hq_state": {
                            "type": "string",
                            "description": "Headquarters state."
                          },
                          "hq_state_code": {
                            "type": "string",
                            "description": "USPS state code for US companies."
                          },
                          "id": {
                            "type": "string",
                            "description": "Provider row identifier. Trove docs describe this as the submitted user_id, but live bulk responses currently return null."
                          },
                          "industry": {
                            "type": "string",
                            "description": "Industry classification."
                          },
                          "linkedin_url": {
                            "type": "string",
                            "description": "Official LinkedIn URL."
                          },
                          "name": {
                            "type": "string",
                            "description": "Company name."
                          },
                          "query": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Original transaction request data echoed by Trove, including description, amount, date, and user_id."
                          },
                          "size": {
                            "type": "string",
                            "description": "Approximate employee headcount band."
                          },
                          "summary": {
                            "type": "string",
                            "description": "Short company summary."
                          },
                          "twitter_url": {
                            "type": "string",
                            "description": "Official X/Twitter URL."
                          },
                          "type": {
                            "type": "string",
                            "description": "Company type such as Public Company or Privately Held."
                          }
                        },
