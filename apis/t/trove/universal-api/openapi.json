    "/v1/universal/trove/latest/actions/enrich-bulk-transactions": {
      "post": {
        "operationId": "trove.enrich-bulk-transactions",
        "summary": "Enrich Bulk Transactions",
        "description": "Creates a bulk transaction enrichment request in Trove.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/trove/latest/actions/enrich-bulk-transactions"
        },
