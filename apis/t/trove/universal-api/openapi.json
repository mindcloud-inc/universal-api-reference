        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "transactions[]",
                  "transactions[].description",
                  "transactions[].amount",
                  "transactions[].date",
                  "transactions[].user_id"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "transactions[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Array of transactions to enrich in bulk."
                  },
                  "transactions[].description": {
                    "type": "string",
                    "description": "The original transaction description string."
                  },
                  "transactions[].amount": {
                    "type": "number",
                    "description": "Transaction value in the original currency."
                  },
                  "transactions[].date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The transaction date in YYYY-MM-DD format."
                  },
                  "transactions[].user_id": {
                    "type": "string",
                    "description": "A unique identifier for the customer/user that performed this transaction."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
