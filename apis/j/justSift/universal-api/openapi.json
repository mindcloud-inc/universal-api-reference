            "schema": {
              "type": "string",
              "description": "Sort direction, asc or desc.",
              "enum": [
                "0",
                "1"
              ],
              "default": "asc"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Advanced Sift PeopleFilters object using and, or, not, or field comparison clauses.",
            "schema": {
              "type": "object",
              "additionalProperties": true,
              "description": "Advanced Sift PeopleFilters object using and, or, not, or field comparison clauses.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of records to return.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of records to skip before returning results.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "where",
            "in": "query",
            "required": false,
            "description": "An RSQL expression used to filter the results.",
            "schema": {
              "type": "string"
            }
          },
          {
