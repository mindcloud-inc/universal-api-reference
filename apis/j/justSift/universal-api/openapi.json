            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Generic term searched across searchable Sift fields.",
            "schema": {
              "type": "string",
              "description": "Generic term searched across searchable Sift fields."
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number to retrieve. Sift pages start at 1.",
            "schema": {
              "type": "number",
              "description": "Page number to retrieve. Sift pages start at 1.",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Number of people to return, from 0 to 100.",
            "schema": {
              "type": "number",
              "description": "Number of people to return, from 0 to 100.",
              "default": 10
            }
          },
          {
            "name": "sortBy",
            "in": "query",
