  "info": {
    "title": "Yandex ID Universal API",
    "version": "0.0.9",
    "description": "Authorize users with Yandex accounts via OAuth 2.0 and read the authenticated user's Yandex ID profile data."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
