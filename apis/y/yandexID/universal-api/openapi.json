            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jwtSecret",
            "in": "query",
            "required": false,
            "description": "Optional shared secret for validating OpenID JWT responses when you request JWT format from Yandex.",
