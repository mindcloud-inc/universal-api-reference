            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageCursor",
            "in": "query",
            "required": false,
            "description": "Pagination cursor returned from the previous Glasp export response.",
            "schema": {
              "type": "string",
              "description": "Pagination cursor returned from the previous Glasp export response."
            }
          },
          {
            "name": "updatedAfter",
            "in": "query",
            "required": false,
            "description": "Only return highlights updated after this ISO date-time string.",
            "schema": {
              "type": "string",
              "description": "Only return highlights updated after this ISO date-time string."
            }
          },
          {
            "name": "fields",
