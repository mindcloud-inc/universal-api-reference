    "/v1/universal/glasp/latest/actions/create-highlights": {
      "post": {
        "operationId": "glasp.create-highlights",
        "summary": "Create Highlights",
        "description": "Creates new highlights in your Glasp account.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/glasp/latest/actions/create-highlights"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "highlights[]"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "highlights[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Array of Glasp highlight objects to create. Each object should include at least title, url, and text."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "description": "Glasp content category for the document."
                          },
                          "domain": {
                            "type": "string",
                            "description": "Source domain for the document."
                          },
                          "glaspUrl": {
                            "type": "string",
                            "description": "Glasp URL for the saved document."
                          },
                          "highlights": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "color": {
                                  "type": "string",
                                  "description": "Created highlight color."
                                },
                                "highlightedAt": {
                                  "type": "string",
                                  "format": "date-time",
                                  "description": "When the highlight was recorded in Glasp."
                                },
                                "highlightUrl": {
                                  "type": "string",
                                  "description": "Unique highlight URL when Glasp provides one."
                                },
                                "id": {
                                  "type": "string",
                                  "description": "Glasp highlight identifier."
                                },
                                "location": {
                                  "type": "number",
                                  "description": "Optional highlight location or timestamp."
                                },
                                "note": {
                                  "type": "string",
                                  "description": "Created highlight note."
                                },
                                "text": {
                                  "type": "string",
                                  "description": "Created highlight text."
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "id": {
                            "type": "string",
                            "description": "Glasp document identifier created or reused for the imported highlights."
                          },
                          "title": {
                            "type": "string",
                            "description": "Title of the source document."
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the document was last updated in Glasp."
                          },
                          "url": {
                            "type": "string",
                            "description": "Original source URL for the created highlights."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
