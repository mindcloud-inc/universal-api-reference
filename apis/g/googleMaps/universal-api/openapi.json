                                "properties": {
                                  "inputGranularity": {
                                    "type": "string"
                                  },
                                  "validationGranularity": {
                                    "type": "string"
                                  },
                                  "geocodeGranularity": {
                                    "type": "string"
                                  },
                                  "addressComplete": {
                                    "type": "boolean"
                                  },
                                  "hasInferredComponents": {
                                    "type": "boolean"
                                  },
                                  "possibleNextAction": {
                                    "type": "string"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "address": {
                                "type": "object",
                                "properties": {
                                  "formattedAddress": {
                                    "type": "string"
                                  },
                                  "postalAddress": {
                                    "type": "object",
                                    "properties": {
                                      "regionCode": {
                                        "type": "string"
                                      },
                                      "languageCode": {
                                        "type": "string"
                                      },
                                      "postalCode": {
                                        "type": "string"
                                      },
                                      "administrativeArea": {
                                        "type": "string"
                                      },
                                      "locality": {
                                        "type": "string"
                                      },
                                      "addressLines": {
                                        "type": "array",
                                        "items": {
                                          "type": "string"
                                        }
                                      }
                                    },
                                    "additionalProperties": false
                                  },
                                  "addressComponents": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "componentName": {
                                          "type": "object",
                                          "properties": {
                                            "text": {
                                              "type": "string"
                                            }
                                          },
                                          "additionalProperties": false
                                        },
                                        "componentType": {
                                          "type": "string"
                                        },
                                        "confirmationLevel": {
                                          "type": "string"
                                        }
                                      },
                                      "additionalProperties": false
                                    }
                                  }
                                },
                                "additionalProperties": false
                              },
                              "geocode": {
                                "type": "object",
                                "properties": {
                                  "location": {
                                    "type": "object",
                                    "properties": {
                                      "latitude": {
                                        "type": "number"
                                      },
                                      "longitude": {
                                        "type": "number"
                                      }
                                    },
                                    "additionalProperties": false
                                  },
                                  "plusCode": {
                                    "type": "object",
                                    "properties": {
                                      "globalCode": {
                                        "type": "string"
                                      }
                                    },
                                    "additionalProperties": false
                                  },
                                  "bounds": {
                                    "type": "object",
                                    "properties": {
                                      "low": {
                                        "type": "object",
                                        "properties": {
                                          "latitude": {
                                            "type": "number"
                                          },
                                          "longitude": {
                                            "type": "number"
