    "/v1/universal/googleMaps/latest/actions/validate-address": {
      "post": {
        "operationId": "googleMaps.validate-address",
        "summary": "Validate Address",
        "description": "Validates an Address",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/googleMaps/latest/actions/validate-address"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "address": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "address.regionCode": {
                    "type": "string",
                    "description": "Optional, but helpful for a complete validation. i.e. `CA` for Canada."
                  },
                  "address.addressLines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required. Unstructured address lines describing the lower levels of an address.\n\nBecause values in addressLines do not have type information and may sometimes contain multiple values in a single field (e.g. \"Austin, TX\"), it is important that the line order is clear. The order of address lines should be \"envelope order\" for the country/region of the address.\n\nThe minimum permitted structural representation of an address consists of all information placed in the addressLines. If a regionCode is not provided, the region is inferred from the address lines.\n\nCreating an address only containing addressLines, and then geocoding is the recommended way to handle completely unstructured addresses (as opposed to guessing which parts of the address should be localities or administrative areas)."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
