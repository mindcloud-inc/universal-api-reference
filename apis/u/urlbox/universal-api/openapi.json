                        "type": "object",
                        "properties": {
                          "renderId": {
                            "type": "string",
                            "description": "Identifier for the accepted async render request."
                          },
                          "status": {
                            "type": "string",
                            "description": "Accepted render status, typically created."
                          },
                          "statusUrl": {
                            "type": "string",
                            "description": "Polling URL for checking the current render status."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
