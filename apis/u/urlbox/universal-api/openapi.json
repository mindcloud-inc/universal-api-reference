    "/v1/universal/urlbox/latest/actions/check-render-status": {
      "get": {
        "operationId": "urlbox.check-render-status",
        "summary": "Check Render Status",
        "description": "Retrieves the status of a render from Urlbox.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/urlbox/latest/actions/check-render-status"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "renderId",
            "in": "query",
            "required": true,
            "description": "The render ID returned by the async render action",
            "schema": {
              "type": "string",
              "description": "The render ID returned by the async render action",
              "example": "250ea007-552c-4555-ba2b-ef1c73e18be2"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
