                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bandwidth": {
                            "type": "number",
                            "description": "Bandwidth used for the generated render in bytes when available."
                          },
                          "queueTime": {
                            "type": "number",
                            "description": "Time spent waiting in queue in milliseconds when available."
                          },
                          "reason": {
                            "type": "string",
                            "description": "Human-readable failure reason when the render fails."
                          },
                          "renderId": {
                            "type": "string",
                            "description": "Identifier for the render request."
                          },
                          "renderTime": {
                            "type": "number",
                            "description": "Render generation time in milliseconds when available."
                          },
                          "renderUrl": {
                            "type": "string",
                            "description": "Generated render URL when the render succeeds."
                          },
                          "size": {
                            "type": "number",
                            "description": "Size of the generated render in bytes when available."
                          },
                          "status": {
                            "type": "string",
                            "description": "Current render status value."
                          },
                          "statusUrl": {
                            "type": "string",
                            "description": "Polling URL for the current render status."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
