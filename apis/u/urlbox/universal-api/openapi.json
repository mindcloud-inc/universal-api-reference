    "/v1/universal/urlbox/latest/actions/create-asynchronous-render": {
      "post": {
        "operationId": "urlbox.create-asynchronous-render",
        "summary": "Create Asynchronous Render",
        "description": "Creates an asynchronous render in Urlbox.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/urlbox/latest/actions/create-asynchronous-render"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "url": {
                    "type": "string",
                    "description": "The URL to render",
                    "example": "https://example.com"
                  },
                  "html": {
                    "type": "string",
                    "description": "The HTML to render",
                    "example": "<html><body>Hello</body></html>"
                  },
                  "format": {
                    "type": "string",
                    "description": "The output format of the render",
                    "example": "png"
                  },
                  "width": {
                    "type": "number",
                    "description": "The viewport width in pixels",
                    "example": 1280
                  },
                  "height": {
                    "type": "number",
                    "description": "The viewport height in pixels",
                    "example": 720
                  },
                  "fullPage": {
                    "type": "boolean",
                    "description": "Capture the full scrollable page"
                  },
                  "selector": {
                    "type": "string",
                    "description": "Capture only the matching element selector",
                    "example": "#main"
                  },
                  "hideCookieBanners": {
                    "type": "boolean",
                    "description": "Automatically hide cookie banners"
                  },
                  "clickAccept": {
                    "type": "boolean",
                    "description": "Try to click the cookie accept button"
                  },
                  "blockAds": {
                    "type": "boolean",
                    "description": "Block popular advertising networks"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
