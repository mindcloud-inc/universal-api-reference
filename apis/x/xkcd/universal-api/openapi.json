    "/v1/universal/xkcd/latest/actions/get-comic": {
      "get": {
        "operationId": "xkcd.get-comic",
        "summary": "Get Comic",
        "description": "Retrieves comic metadata from Xkcd by comic number.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/xkcd/latest/actions/get-comic"
        },
