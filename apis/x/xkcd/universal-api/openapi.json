                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "alt": {
                            "type": "string",
                            "description": "Comic alt text."
                          },
                          "day": {
                            "type": "string",
                            "description": "Publication day of month."
                          },
                          "img": {
                            "type": "string",
                            "description": "Comic image URL."
                          },
                          "link": {
                            "type": "string",
                            "description": "External link associated with the comic, when present."
                          },
                          "month": {
                            "type": "string",
                            "description": "Publication month number."
                          },
                          "news": {
                            "type": "string",
                            "description": "News text associated with the comic, when present."
                          },
                          "num": {
                            "type": "number",
                            "description": "xkcd comic number."
                          },
                          "safe_title": {
                            "type": "string",
                            "description": "Safe title variant from xkcd."
                          },
                          "title": {
                            "type": "string",
                            "description": "Comic title."
                          },
                          "transcript": {
                            "type": "string",
                            "description": "Comic transcript, when available."
                          },
                          "year": {
                            "type": "string",
                            "description": "Publication year."
                          }
                        },
                        "additionalProperties": false
