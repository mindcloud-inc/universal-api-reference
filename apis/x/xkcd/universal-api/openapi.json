          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "comicNumber",
            "in": "query",
            "required": true,
            "description": "The xkcd comic number to fetch, as documented in the /614/info.0.json example.",
            "schema": {
              "type": "number",
              "description": "The xkcd comic number to fetch, as documented in the /614/info.0.json example.",
              "example": 614
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
