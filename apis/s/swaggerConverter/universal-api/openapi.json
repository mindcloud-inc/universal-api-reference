        "summary": "Convert Definition by URL",
        "description": "Retrieves a converted OpenAPI document from Swagger Converter by source URL.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/swaggerConverter/latest/actions/convert-definition-by-url"
        },
        "security": [
          {
            "bearerAuth": []
