            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "A URL to the Swagger/OpenAPI 1.x or 2.x definition to convert.",
            "schema": {
              "type": "string",
              "description": "A URL to the Swagger/OpenAPI 1.x or 2.x definition to convert.",
              "example": "https://petstore.swagger.io/v2/swagger.json"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
