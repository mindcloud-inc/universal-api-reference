  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Swagger Converter Universal API",
    "version": "0.0.5",
    "description": "Convert Swagger definitions to OpenAPI 3.0"
  },
  "servers": [
