        "operationId": "splitCSV.retrieve-profile",
        "summary": "Retrieve Profile",
        "description": "Retrieves the current user profile from Split CSV.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/splitCSV/latest/actions/retrieve-profile"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "defaultRetention": {
                            "type": "number",
                            "description": "The default retention period in days."
                          },
                          "email": {
                            "type": "string",
                            "description": "The account email address."
                          },
                          "name": {
                            "type": "string",
                            "description": "The account display name."
                          },
                          "perFileNotifications": {
                            "type": "boolean",
                            "description": "Whether per-file webhook notifications are enabled."
                          },
                          "provider": {
                            "type": "string",
                            "description": "The account authentication provider."
                          },
                          "timezone": {
                            "type": "string",
