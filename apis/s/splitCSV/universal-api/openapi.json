            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The order ID returned by Create Order. Use latest to retrieve the most recent order.",
            "schema": {
              "type": "string",
              "description": "The order ID returned by Create Order. Use latest to retrieve the most recent order.",
              "example": "latest"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
