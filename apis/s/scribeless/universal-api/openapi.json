                  },
                  "data[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Array of recipient payload objects for multiple Scribeless recipients."
                  },
                  "data[].title": {
                    "type": "string",
                    "description": "Recipient title such as Mr or Mrs."
                  },
                  "data[].firstName": {
                    "type": "string",
