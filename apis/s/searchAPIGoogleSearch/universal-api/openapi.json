    "/v1/universal/searchAPIGoogleSearch/latest/actions/find-supported-locations": {
      "get": {
        "operationId": "searchAPIGoogleSearch.find-supported-locations",
        "summary": "Find Supported Locations",
        "description": "Finds supported Google search locations in SearchAPI.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/searchAPIGoogleSearch/latest/actions/find-supported-locations"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Location search text such as london or new york.",
            "schema": {
              "type": "string",
              "description": "Location search text such as london or new york.",
              "example": "london"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of locations to return. Defaults to 10 and can be up to 100.",
            "schema": {
              "type": "number",
              "description": "Maximum number of locations to return. Defaults to 10 and can be up to 100.",
              "default": 10
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "canonical_name": {
                            "type": "string",
                            "description": "Canonical SearchAPI location name."
                          },
                          "country_code": {
                            "type": "string",
                            "description": "ISO country code."
                          },
                          "google_id": {
                            "type": "number",
                            "description": "Google location identifier."
                          },
                          "google_parent_id": {
                            "type": "number",
                            "description": "Google parent location identifier."
                          },
                          "lat": {
                            "type": "number",
                            "description": "Latitude."
                          },
                          "lon": {
                            "type": "number",
                            "description": "Longitude."
                          },
                          "name": {
                            "type": "string",
                            "description": "Location display name."
                          },
                          "reach": {
                            "type": "number",
                            "description": "Estimated location reach."
                          },
                          "target_type": {
                            "type": "string",
                            "description": "SearchAPI location target type."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
