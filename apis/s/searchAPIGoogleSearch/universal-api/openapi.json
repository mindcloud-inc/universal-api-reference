  "info": {
    "title": "SearchAPI - Google Search Universal API",
    "version": "0.1.3",
    "description": "Search Google in real time through SearchAPI and retrieve structured search results, supported locations, and account usage data."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
