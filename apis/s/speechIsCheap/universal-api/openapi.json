    "/v1/universal/speechIsCheap/latest/actions/get-transcription-job": {
      "get": {
        "operationId": "speechIsCheap.get-transcription-job",
        "summary": "Get Transcription Job",
        "description": "Retrieves a transcription job from Speech is Cheap.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/speechIsCheap/latest/actions/get-transcription-job"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "in": "query",
            "required": true,
            "description": "Speech is Cheap transcription job ID.",
            "schema": {
              "type": "string",
              "description": "Speech is Cheap transcription job ID.",
              "example": "00000000-1111-7222-b333-444444444444-sic"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Speech is Cheap transcription job identifier."
                          },
                          "output": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Transcription output object. It is empty for pending or canceled jobs.",
                            "properties": {
                              "error": {
                                "type": "string",
                                "description": "Failure message when the job fails."
                              },
                              "segments": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "confidence": {
                                      "type": "number",
                                      "description": "Transcription or label confidence when returned."
                                    },
                                    "end": {
                                      "type": "number",
                                      "description": "Segment end time in seconds."
                                    },
                                    "id": {
                                      "type": "number",
                                      "description": "Segment identifier."
                                    },
                                    "label": {
                                      "type": "string",
                                      "description": "Audio label when label-audio is enabled."
                                    },
                                    "language": {
                                      "type": "string",
                                      "description": "Detected segment language when returned."
                                    },
                                    "processingDurationInS": {
                                      "type": "number",
                                      "description": "Segment processing duration in seconds when returned."
                                    },
                                    "seek": {
                                      "type": "number",
                                      "description": "Segment seek offset when returned."
                                    },
                                    "speakerId": {
                                      "type": "string",
                                      "description": "Speaker label when speaker parsing is enabled."
                                    },
                                    "start": {
                                      "type": "number",
                                      "description": "Segment start time in seconds."
                                    },
                                    "text": {
                                      "type": "string",
                                      "description": "Transcribed segment text."
                                    },
                                    "words": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "end": {
                                            "type": "number",
                                            "description": "Word end time in seconds."
                                          },
                                          "start": {
                                            "type": "number",
                                            "description": "Word start time in seconds."
                                          },
                                          "text": {
                                            "type": "string",
                                            "description": "Recognized word text."
                                          }
                                        },
                                        "additionalProperties": false
                                      }
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              }
                            }
                          },
                          "status": {
                            "type": "string",
                            "description": "Job status, such as PENDING, COMPLETED, CANCELED, or FAILED."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
