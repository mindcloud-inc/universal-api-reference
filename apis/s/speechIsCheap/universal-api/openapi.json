    "/v1/universal/speechIsCheap/latest/actions/create-transcription-job": {
      "post": {
        "operationId": "speechIsCheap.create-transcription-job",
        "summary": "Create Transcription Job",
        "description": "Creates a new transcription job in Speech is Cheap.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/speechIsCheap/latest/actions/create-transcription-job"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "inputUrl"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "inputUrl": {
                    "type": "string",
                    "description": "Publicly accessible audio or video file URL to transcribe.",
                    "example": "https://example.com/audio-file.mp3"
                  },
                  "webhookUrl": {
                    "type": "string",
                    "description": "Optional URL where Speech is Cheap may POST transcription results.",
                    "example": "https://your-domain.com/webhook"
                  },
                  "language": {
                    "type": "string",
                    "description": "Optional two-letter ISO 639-1 language code, such as en or es. Omit for auto-detection.",
                    "example": "en"
                  },
                  "canLabelAudio": {
                    "type": "boolean",
                    "description": "When enabled, includes audio classification labels in transcription output.",
                    "x-mindcloud-advanced": true
                  },
                  "canParseSpeakers": {
                    "type": "boolean",
                    "description": "When enabled, includes speaker_id on each segment.",
                    "x-mindcloud-advanced": true
                  },
                  "canParseWords": {
                    "type": "boolean",
                    "description": "When enabled, includes timestamps for each word.",
                    "x-mindcloud-advanced": true
                  },
                  "isPrivate": {
                    "type": "boolean",
                    "description": "When enabled, redacts the original input_url and deletes segments after 12 hours.",
                    "x-mindcloud-advanced": true
                  },
                  "minimumConfidence": {
                    "type": "number",
                    "description": "Filters out segments below this confidence threshold. Defaults to 0.5.",
                    "example": 0.5,
                    "x-mindcloud-advanced": true
                  },
                  "segmentDuration": {
                    "type": "number",
                    "description": "Transcription segment duration in seconds. Must be between 6 and 30.",
                    "example": 30,
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Speech is Cheap transcription job identifier."
                          },
                          "output": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Job output object. It is empty when an asynchronous job is first accepted."
                          },
                          "status": {
                            "type": "string",
                            "description": "Job status returned after creation, such as PENDING."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
