            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "name"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "company": {
                    "type": "string",
                    "description": "The company name for the testimonial author."
                  },
                  "companyRole": {
                    "type": "string",
                    "description": "The job title or role for the testimonial author."
                  },
                  "email": {
                    "type": "string",
                    "description": "The email address of the testimonial author."
                  },
                  "imageUrl": {
                    "type": "string",
                    "description": "The image URL for the testimonial author."
                  },
                  "link": {
                    "type": "string",
                    "description": "A link associated with the testimonial author."
                  },
                  "name": {
                    "type": "string",
                    "description": "The name of the testimonial author."
                  },
                  "rating": {
                    "type": "number",
                    "description": "The testimonial rating."
                  },
                  "text": {
                    "type": "string",
                    "description": "The testimonial text."
                  },
                  "type": {
                    "type": "string",
                    "description": "The testimonial type."
                  },
                  "videoUrl": {
                    "type": "string",
                    "description": "The testimonial video URL."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
