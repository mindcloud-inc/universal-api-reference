    "/v1/universal/storydoc/latest/actions/list-stories": {
      "get": {
        "operationId": "storydoc.list-stories",
        "summary": "List Stories",
        "description": "Retrieves stories from Storydoc.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/storydoc/latest/actions/list-stories"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter stories by status.",
            "schema": {
              "type": "string",
              "description": "Filter stories by status.",
              "enum": [
                "Archived",
                "Draft",
                "Live"
              ]
            }
          },
