    "/v1/universal/storydoc/latest/actions/create-story-version": {
      "post": {
        "operationId": "storydoc.create-story-version",
        "summary": "Create Story Version",
        "description": "Creates a new story version in Storydoc.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/storydoc/latest/actions/create-story-version"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "storyId",
                  "senderEmail",
                  "data"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "storyId": {
                    "type": "string",
                    "description": "The ID of the story template to version."
                  },
                  "senderEmail": {
                    "type": "string",
                    "description": "Email of the sender. It must exist in the Storydoc organization."
                  },
                  "daysToExpire": {
                    "type": "number",
                    "description": "Number of days until the version expires."
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Storydoc version data object. It must include at least a title field."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "editorUrl": {
                            "type": "string",
                            "description": "Storydoc editor URL for the created version."
                          },
                          "shortUrl": {
                            "type": "string",
                            "description": "Shortened public URL for the created version."
                          },
                          "url": {
                            "type": "string",
                            "description": "Public URL for the created version."
                          },
                          "versionId": {
                            "type": "string",
                            "description": "Unique identifier for the created version."
                          },
                          "versionUrl": {
                            "type": "string",
                            "description": "Storydoc version details URL."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
