    "/v1/universal/sipuni/latest/actions/call-number": {
      "post": {
        "operationId": "sipuni.call-number",
        "summary": "Call Number",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/sipuni/latest/actions/call-number"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "phone",
                  "sipnumber"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "phone": {
                    "type": "string",
                    "description": "External customer phone number to call."
                  },
                  "sipnumber": {
                    "type": "string",
                    "description": "Sipuni employee short extension that initiates or receives the callback order."
                  },
                  "reverse": {
                    "type": "string",
                    "description": "Sipuni callback mode flag. Default 0 follows the standard employee-to-customer callback order.",
                    "default": "0",
                    "x-mindcloud-advanced": true
                  },
                  "antiaon": {
                    "type": "string",
                    "description": "Caller ID hiding flag. Default 0 leaves caller ID behavior unchanged.",
                    "default": "0",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
