                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "aliasName": {
                            "type": "string",
                            "description": "Created alias name."
                          },
                          "domainName": {
                            "type": "string",
                            "description": "Domain attached to the created alias."
                          },
                          "shortUrl": {
                            "type": "string",
                            "description": "Generated shortened URL."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
