                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "domainName": {
                    "type": "string",
                    "description": "The domain to attach the alias to, without http/https or trailing slash."
                  },
                  "aliasName": {
                    "type": "string",
                    "description": "Optional alias value without a leading slash. Leave blank to let Shorten.REST generate one."
                  },
                  "destinations": {
                    "type": "string",
                    "description": "List of destination objects. Each object should include at least a url and may also include country or os."
                  },
                  "metatags": {
                    "type": "string",
                    "description": "Optional list of meta tag objects with name and content fields."
                  },
                  "snippets": {
                    "type": "string",
                    "description": "Optional list of snippet objects with id and parameters."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
