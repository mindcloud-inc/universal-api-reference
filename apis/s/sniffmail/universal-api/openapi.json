    "/v1/universal/sniffmail/latest/actions/get-job-results": {
      "get": {
        "operationId": "sniffmail.get-job-results",
        "summary": "Get Job Results",
        "description": "Retrieves results for a bulk verification job.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/sniffmail/latest/actions/get-job-results"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "in": "query",
            "required": true,
            "description": "Provide the Sniffmail bulk job ID returned by Create Bulk Job.",
            "schema": {
              "type": "string",
              "description": "Provide the Sniffmail bulk job ID returned by Create Bulk Job.",
              "example": "job_abc123xyz"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "job": {
                            "type": "object",
                            "properties": {
                              "completedAt": {
                                "type": "string",
                                "description": "When Sniffmail completed the bulk job."
                              },
                              "createdAt": {
                                "type": "string",
                                "description": "When Sniffmail created the bulk job."
                              },
                              "id": {
                                "type": "string",
                                "description": "The Sniffmail bulk job identifier."
                              },
                              "invalidEmails": {
                                "type": "number",
                                "description": "How many job emails Sniffmail classified as invalid."
                              },
                              "processedEmails": {
                                "type": "number",
                                "description": "How many email addresses Sniffmail processed."
                              },
                              "status": {
                                "type": "string",
                                "description": "The final or current job status."
                              },
                              "totalEmails": {
                                "type": "number",
                                "description": "How many email addresses were submitted in the job."
                              },
                              "validEmails": {
                                "type": "number",
                                "description": "How many job emails Sniffmail classified as valid."
                              }
                            },
                            "additionalProperties": false
                          },
                          "results": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "deliverabilityScore": {
                                  "type": "number",
                                  "description": "The provider deliverability score for the email result."
                                },
                                "disposable": {
                                  "type": "boolean",
                                  "description": "Whether Sniffmail classified the address as disposable."
                                },
                                "email": {
                                  "type": "string",
                                  "description": "The email address Sniffmail evaluated."
                                },
                                "freeProvider": {
                                  "type": "boolean",
                                  "description": "Whether Sniffmail classified the domain as a free email provider."
                                },
                                "mxRecords": {
                                  "type": "boolean",
                                  "description": "Whether the domain has MX records according to Sniffmail."
                                },
                                "reason": {
                                  "type": "string",
                                  "description": "The provider reason associated with the email result."
                                },
                                "result": {
                                  "type": "string",
                                  "description": "The provider classification for the email result."
                                },
                                "roleAccount": {
                                  "type": "boolean",
                                  "description": "Whether Sniffmail classified the address as a role account."
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
