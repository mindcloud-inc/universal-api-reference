  "info": {
    "title": "Sniffmail Universal API",
    "version": "0.0.3",
    "description": "Verify email addresses, detect disposable inboxes, and improve sender deliverability with Sniffmail's email verification API."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
