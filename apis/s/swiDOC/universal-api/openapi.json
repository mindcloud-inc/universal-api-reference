    "/v1/universal/swiDOC/latest/actions/update-document-metadata": {
      "put": {
        "operationId": "swiDOC.update-document-metadata",
        "summary": "Update Document Metadata",
        "description": "Updates document metadata in swiDOC by document ID.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/swiDOC/latest/actions/update-document-metadata"
