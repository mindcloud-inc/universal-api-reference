                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "documentId": {
                    "type": "string",
                    "description": "Unique ID of the document whose metadata should be updated."
                  },
                  "fileName": {
                    "type": "string",
                    "description": "Optional new file name including extension."
                  },
                  "filePath": {
                    "type": "string",
