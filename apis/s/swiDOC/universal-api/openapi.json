                  "connectionId",
                  "fileContent",
                  "metadata.fileName"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "fileContent": {
                    "type": "string",
                    "description": "Base64 encoded file content."
                  },
                  "metadata.fileName": {
                    "type": "string",
                    "description": "Name of the file including extension."
                  },
                  "metadata.filePath": {
                    "type": "string",
                    "description": "Optional archive folder path. The folder will be created if it does not exist."
                  },
                  "metadata.description": {
                    "type": "string",
                    "description": "Optional text used for indexing the document."
                  },
                  "metadata.tags[]": {
                    "type": "array",
