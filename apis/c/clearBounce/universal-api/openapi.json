                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "duplicateCount": {
                            "type": "number",
                            "description": "Number of duplicate rows removed from the submitted payload."
                          },
                          "emptyRows": {
                            "type": "number",
                            "description": "Number of empty rows in the submitted batch payload."
                          },
                          "estimatedTimeSeconds": {
                            "type": "number",
                            "description": "Provider-estimated processing time for the batch job."
                          },
                          "invalidRows": {
                            "type": "number",
