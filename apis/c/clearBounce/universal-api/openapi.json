                          },
                          "jobId": {
                            "type": "string",
                            "description": "The created ClearBounce batch verification job ID."
                          },
                          "skippedRows": {
                            "type": "number",
                            "description": "Number of skipped rows in the submitted batch payload."
                          },
                          "success": {
                            "type": "boolean",
                            "description": "Whether the batch upload request succeeded."
                          },
                          "totalEmails": {
                            "type": "number",
