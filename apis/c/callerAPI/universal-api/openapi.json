    "/v1/universal/callerAPI/latest/actions/lookup-spam-score-and-hlr": {
      "get": {
        "operationId": "callerAPI.lookup-spam-score-and-hlr",
        "summary": "Lookup Spam Score and HLR",
        "description": "Retrieves spam score and HLR data from CallerAPI.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/callerAPI/latest/actions/lookup-spam-score-and-hlr"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hlr",
            "in": "query",
            "required": false,
            "description": "Whether to include HLR data.",
            "schema": {
              "type": "boolean",
              "description": "Whether to include HLR data."
            }
          },
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "description": "Phone number to look up.",
            "schema": {
              "type": "string",
              "description": "Phone number to look up."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Lookup result payload returned by CallerAPI.",
                            "properties": {
                              "business_info": {
                                "type": "object",
                                "additionalProperties": false,
                                "description": "Business details when the phone number is associated with a verified business.",
                                "properties": {
                                  "business_name": {
                                    "type": "string",
                                    "description": "Verified business name for the phone number."
                                  },
                                  "category": {
                                    "type": "string",
                                    "description": "High-level business category."
                                  },
                                  "city": {
                                    "type": "string",
                                    "description": "Business city."
                                  },
                                  "country": {
                                    "type": "string",
                                    "description": "Business country code."
                                  },
                                  "industry": {
                                    "type": "string",
                                    "description": "Business industry label."
                                  },
                                  "state": {
                                    "type": "string",
                                    "description": "Business state or region."
                                  },
                                  "verified": {
                                    "type": "boolean",
                                    "description": "Whether CallerAPI verified the business information."
                                  }
                                }
                              },
                              "entity_type": {
                                "type": "string",
                                "description": "Entity classification returned by CallerAPI."
                              },
                              "is_spam": {
                                "type": "boolean",
                                "description": "Whether CallerAPI classifies the phone number as spam."
                              },
                              "phone": {
                                "type": "string",
                                "description": "Normalized phone number that was looked up."
                              },
                              "reputation": {
                                "type": "string",
                                "description": "CallerAPI reputation label for the phone number."
                              },
                              "spam_score": {
                                "type": "number",
                                "description": "Numeric spam score for the phone number."
                              },
                              "total_complaints": {
                                "type": "number",
                                "description": "Total number of complaints associated with the phone number."
                              }
                            }
                          },
                          "status": {
                            "type": "string",
                            "description": "CallerAPI response status."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
