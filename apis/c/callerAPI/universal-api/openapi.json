    "/v1/universal/callerAPI/latest/actions/get-balance-and-email": {
      "get": {
        "operationId": "callerAPI.get-balance-and-email",
        "summary": "Get Balance and Email",
        "description": "Retrieves account balance and email from CallerAPI.",
