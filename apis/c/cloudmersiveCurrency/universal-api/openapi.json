    "/v1/universal/cloudmersiveCurrency/latest/actions/list-available-currencies": {
      "get": {
        "operationId": "cloudmersiveCurrency.list-available-currencies",
        "summary": "List Available Currencies",
        "description": "Retrieves available currencies from Cloudmersive Currency.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/cloudmersiveCurrency/latest/actions/list-available-currencies"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
