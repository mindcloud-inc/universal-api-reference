        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Currencies": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "CountryISOTwoLetterCode": {
                                  "type": "string",
                                  "description": "Two-letter ISO 3166-1 country code."
                                },
                                "CountryName": {
                                  "type": "string",
                                  "description": "Country name."
                                },
                                "CountryThreeLetterCode": {
                                  "type": "string",
                                  "description": "Three-letter ISO 3166-1 country code."
                                },
                                "CurrencyEnglishName": {
                                  "type": "string",
                                  "description": "English currency name."
                                },
                                "CurrencySymbol": {
                                  "type": "string",
                                  "description": "Currency symbol."
                                },
                                "IsEuropeanUnionMember": {
                                  "type": "boolean",
                                  "description": "Whether the country is currently an EU member."
                                },
                                "ISOCurrencyCode": {
                                  "type": "string",
                                  "description": "ISO 4217 currency three-letter code."
                                }
                              }
                            },
                            "description": "Available currencies and corresponding countries."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
