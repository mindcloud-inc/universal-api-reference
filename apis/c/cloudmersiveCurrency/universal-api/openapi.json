{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Cloudmersive Currency Universal API",
    "version": "0.0.2",
    "description": "Retrieve Cloudmersive currency exchange rates, list supported currencies, and convert prices between currency pairs."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/cloudmersiveCurrency/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/cloudmersiveCurrency/latest/actions/convert-currency": {
      "get": {
        "operationId": "cloudmersiveCurrency.convert-currency",
        "summary": "Convert Currency",
        "description": "Converts a currency amount in Cloudmersive Currency.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/cloudmersiveCurrency/latest/actions/convert-currency"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": true,
            "description": "Source currency three-digit ISO 4217 code, such as USD or EUR.",
            "schema": {
              "type": "string",
              "description": "Source currency three-digit ISO 4217 code, such as USD or EUR."
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "description": "Destination currency three-digit ISO 4217 code, such as USD or EUR.",
            "schema": {
              "type": "string",
              "description": "Destination currency three-digit ISO 4217 code, such as USD or EUR."
            }
          },
          {
            "name": "price",
            "in": "query",
            "required": true,
            "description": "Input price in the source currency, such as 19.99.",
            "schema": {
              "type": "number",
              "description": "Input price in the source currency, such as 19.99."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ConvertedPrice": {
                            "type": "number",
                            "description": "Converted price in the destination currency."
                          },
                          "CurrencySymbol": {
                            "type": "string",
                            "description": "Destination currency symbol."
                          },
                          "FormattedPriceAsString": {
                            "type": "string",
                            "description": "Formatted destination price string."
                          },
                          "ISOCurrencyCode": {
                            "type": "string",
                            "description": "ISO 4217 destination currency code."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
