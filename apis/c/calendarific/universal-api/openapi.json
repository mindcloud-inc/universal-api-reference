  "paths": {
    "/v1/universal/calendarific/latest/actions/list-countries": {
      "get": {
        "operationId": "calendarific.list-countries",
        "summary": "List Countries",
        "description": "Retrieves supported countries from Calendarific.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/calendarific/latest/actions/list-countries"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "countryName": {
                            "type": "string",
                            "description": "Country name."
                          },
                          "flagUnicode": {
                            "type": "string",
                            "description": "Unicode flag for the country."
                          },
                          "iso3166": {
                            "type": "string",
                            "description": "ISO 3166 country code."
                          },
                          "supportedLanguages": {
                            "type": "number",
                            "description": "Number of supported languages for the country."
                          },
                          "totalHolidays": {
                            "type": "number",
                            "description": "Number of holidays supported for the country."
                          },
                          "uuid": {
                            "type": "string",
                            "description": "Calendarific country identifier."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
