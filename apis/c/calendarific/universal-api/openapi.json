  "info": {
    "title": "Calendarific Universal API",
    "version": "0.1.3",
    "description": "Calendarific provides worldwide holiday and observance data across countries, states, regions, and languages."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
