  "paths": {
    "/v1/universal/climatiq/latest/actions/estimate-emissions": {
      "post": {
        "operationId": "climatiq.estimate-emissions",
        "summary": "Estimate Emissions",
        "description": "Estimates emissions in Climatiq from activity data.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/climatiq/latest/actions/estimate-emissions"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "emissionFactor",
                  "parameters"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "emissionFactor": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Emission factor selector object, such as activity_id and data_version."
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Activity data parameters object matching the selected factor unit type."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "activity_data": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Activity value and unit used in the calculation."
                          },
                          "additional_indicators": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Supplementary indicator data."
                          },
                          "audit_trail": {
                            "type": "string",
                            "description": "Audit trail state for the response."
                          },
                          "co2e": {
                            "type": "number",
                            "description": "Calculated carbon dioxide equivalent."
                          },
                          "co2e_calculation_method": {
                            "type": "string",
                            "description": "Calculation method used for the estimate."
                          },
                          "co2e_calculation_origin": {
                            "type": "string",
                            "description": "Whether Climatiq or the source performed the calculation."
                          },
                          "co2e_unit": {
                            "type": "string",
                            "description": "Unit for the CO2e amount."
                          },
                          "constituent_gases": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Greenhouse gas breakdown for the estimate."
                          },
                          "emission_factor": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Emission factor used for the estimate."
                          },
                          "notices": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Calculation notices."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
