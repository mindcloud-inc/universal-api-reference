            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataVersion",
            "in": "query",
            "required": true,
            "description": "Required Climatiq data version, such as ^33.",
            "schema": {
              "type": "string",
              "description": "Required Climatiq data version, such as ^33.",
              "example": "^33"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Free-text emission factor search query.",
            "schema": {
              "type": "string",
              "description": "Free-text emission factor search query."
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Region code filter, such as GB or US-CA.",
            "schema": {
              "type": "string",
              "description": "Region code filter, such as GB or US-CA.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "description": "Emission factor year filter.",
            "schema": {
              "type": "number",
              "description": "Emission factor year filter.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Emission factor category filter.",
            "schema": {
              "type": "string",
              "description": "Emission factor category filter.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "unitType",
            "in": "query",
            "required": false,
            "description": "Unit type filter, such as Energy, Money, Weight, or Distance.",
