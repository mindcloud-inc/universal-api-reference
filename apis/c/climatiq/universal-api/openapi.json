              "type": "string",
              "description": "Unit type filter, such as Energy, Money, Weight, or Distance.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "GHG Protocol scope filter, such as 1, 2, 3, or 3.1.",
            "schema": {
              "type": "string",
              "description": "GHG Protocol scope filter, such as 1, 2, 3, or 3.1.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "calculationMethod",
            "in": "query",
            "required": false,
            "description": "Calculation method filter: ar4, ar5, or ar6.",
            "schema": {
              "type": "string",
              "description": "Calculation method filter: ar4, ar5, or ar6.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "accessType",
            "in": "query",
            "required": false,
            "description": "Emission factor access type: public, private, or premium.",
            "schema": {
              "type": "string",
              "description": "Emission factor access type: public, private, or premium.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page number. Climatiq defaults to 1.",
            "schema": {
              "type": "number",
              "description": "Results page number. Climatiq defaults to 1.",
