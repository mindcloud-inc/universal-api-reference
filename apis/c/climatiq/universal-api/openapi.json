    "/v1/universal/climatiq/latest/actions/search-emission-factors": {
      "get": {
        "operationId": "climatiq.search-emission-factors",
        "summary": "Search Emission Factors",
        "description": "Finds emission factors in Climatiq by search criteria.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/climatiq/latest/actions/search-emission-factors"
