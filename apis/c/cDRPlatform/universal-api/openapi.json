    "/v1/universal/cDRPlatform/latest/actions/purchase-co2-removal": {
      "post": {
        "operationId": "cDRPlatform.purchase-co2-removal",
        "summary": "Purchase CO2 Removal",
        "description": "Creates a CO2 removal purchase in CDR Platform.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/cDRPlatform/latest/actions/purchase-co2-removal"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "weightUnit",
                  "currency",
                  "items[].methodType",
                  "items[].cdrAmount"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "weightUnit": {
                    "type": "string",
                    "description": "Unit for the CO2 removal amount.",
                    "enum": [
                      "g",
                      "kg",
                      "t"
                    ],
                    "example": "kg"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency for the purchase request.",
                    "enum": [
                      "chf",
                      "eur",
                      "gbp",
                      "usd"
                    ],
                    "example": "usd"
                  },
                  "items[].methodType": {
                    "type": "string",
                    "description": "Carbon removal method type for an item.",
                    "enum": [
                      "bio-oil",
                      "forestation",
                      "kelp-sinking",
                      "olivine"
                    ],
                    "example": "forestation"
                  },
                  "items[].cdrAmount": {
                    "type": "number",
                    "description": "Amount of CO2 removal for an item, in the selected weight unit.",
                    "example": 1000
                  },
                  "clientReferenceId": {
                    "type": "string",
                    "description": "Optional client reference ID to store with the purchase request.",
                    "example": "order-123",
                    "x-mindcloud-advanced": true
                  },
                  "certificateDisplayName": {
                    "type": "string",
                    "description": "Optional display name for the removal certificate.",
                    "example": "Earth Day removal",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "transaction_uuid": {
                            "type": "string",
                            "description": "Unique transaction UUID for the CDR purchase request."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
