  "paths": {
    "/v1/universal/cDRPlatform/latest/actions/calculate-co2-removal-price": {
      "get": {
        "operationId": "cDRPlatform.calculate-co2-removal-price",
        "summary": "Calculate CO2 Removal Price",
        "description": "Calculates CO2 removal pricing in CDR Platform.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/cDRPlatform/latest/actions/calculate-co2-removal-price"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "weightUnit",
            "in": "query",
            "required": true,
            "description": "Unit for the CO2 removal amount.",
            "schema": {
              "type": "string",
              "description": "Unit for the CO2 removal amount.",
              "enum": [
                "g",
                "kg",
                "t"
              ],
              "example": "kg"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": true,
            "description": "Currency for the price calculation.",
            "schema": {
              "type": "string",
              "description": "Currency for the price calculation.",
              "enum": [
                "chf",
                "eur",
                "gbp",
                "usd"
              ],
              "example": "usd"
            }
          },
          {
            "name": "items[].methodType",
            "in": "query",
            "required": true,
            "description": "Carbon removal method type for an item.",
            "schema": {
              "type": "string",
              "description": "Carbon removal method type for an item.",
              "enum": [
                "bio-oil",
                "forestation",
                "kelp-sinking",
                "olivine"
              ],
              "example": "forestation"
            }
          },
          {
            "name": "items[].cdrAmount",
            "in": "query",
            "required": true,
            "description": "Amount of CO2 removal for an item, in the selected weight unit.",
            "schema": {
              "type": "number",
              "description": "Amount of CO2 removal for an item, in the selected weight unit.",
              "example": 1000
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cost": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Cost breakdown for the price calculation.",
                            "properties": {
                              "items": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "cdr_amount": {
                                      "type": "number",
                                      "description": "Requested removal amount."
                                    },
                                    "cost": {
                                      "type": "number",
                                      "description": "Cost for this removal method item."
                                    },
                                    "method_type": {
                                      "type": "string",
                                      "description": "Removal method type."
                                    }
                                  }
                                },
                                "description": "Per-removal-method price rows."
                              },
                              "removal": {
                                "type": "number",
                                "description": "Removal cost subtotal."
                              },
                              "total": {
                                "type": "number",
                                "description": "Total calculated cost."
                              },
                              "variable_fees": {
                                "type": "number",
                                "description": "Variable fees subtotal."
                              }
                            }
                          },
                          "currency": {
                            "type": "string",
                            "description": "Currency for the calculated cost."
                          },
                          "weight_unit": {
                            "type": "string",
                            "description": "Weight unit used in the calculation."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/cDRPlatform/latest/actions/get-cdr-certificate-by-id": {
      "get": {
        "operationId": "cDRPlatform.get-cdr-certificate-by-id",
        "summary": "Get CDR Certificate By ID",
        "description": "Retrieves a CDR certificate by ID from CDR Platform.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/cDRPlatform/latest/actions/get-cdr-certificate-by-id"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Certificate ID using the documented three-part code format, for example ABC-DEF-GHI.",
            "schema": {
              "type": "string",
              "description": "Certificate ID using the documented three-part code format, for example ABC-DEF-GHI.",
              "example": "ABC-DEF-GHI"
            }
          },
          {
