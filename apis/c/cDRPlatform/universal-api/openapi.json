    "title": "CDR Platform Universal API",
    "version": "0.0.3",
    "description": "Price, purchase, and verify carbon removal orders"
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/cDRPlatform/latest"
  },
