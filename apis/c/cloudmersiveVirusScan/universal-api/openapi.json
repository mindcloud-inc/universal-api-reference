    "/v1/universal/cloudmersiveVirusScan/latest/actions/scan-website-for-threats": {
      "get": {
        "operationId": "cloudmersiveVirusScan.scan-website-for-threats",
        "summary": "Scan Website for Threats",
        "description": "Scans a website for malicious content with Cloudmersive Virus Scan.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/cloudmersiveVirusScan/latest/actions/scan-website-for-threats"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Website URL to scan for malicious content and threats. Must begin with http:// or https://.",
            "schema": {
              "type": "string",
              "description": "Website URL to scan for malicious content and threats. Must begin with http:// or https://."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "CleanResult": {
                            "type": "boolean",
                            "description": "True when the website scan finds no malicious content or threats."
                          },
                          "FoundViruses": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "FileName": {
                                  "type": "string",
                                  "description": "File name or content item where the virus was found."
                                },
                                "VirusName": {
                                  "type": "string",
                                  "description": "Detected virus or malware name."
                                }
                              }
                            },
                            "description": "Viruses found in website content, when any are detected."
                          },
                          "WebsiteHttpResponseCode": {
                            "type": "number",
                            "description": "HTTP response code observed while scanning the website."
                          },
                          "WebsiteThreatType": {
                            "type": "string",
                            "description": "Threat category detected for the website, when any."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
