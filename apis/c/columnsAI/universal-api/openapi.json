    "/v1/universal/columnsAI/latest/actions/get-visual-template": {
      "get": {
        "operationId": "columnsAI.get-visual-template",
        "summary": "Get Visual Template",
        "description": "Retrieves a visual template from Columns AI by visual ID.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/columnsAI/latest/actions/get-visual-template"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Columns visual ID to load as a template.",
            "schema": {
              "type": "string",
              "description": "Columns visual ID to load as a template.",
              "example": "U6tALuJ3cTdPFw"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "access": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Access settings for the visual."
                          },
                          "createdAt": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Created timestamp object from Columns."
                          },
                          "creator": {
                            "type": "string",
                            "description": "Creator user ID."
                          },
                          "current": {
                            "type": "string",
                            "description": "Current version identifier."
                          },
                          "graph": {
                            "type": "string",
                            "description": "Compressed graph payload returned by the Columns snapshot endpoint."
                          },
                          "id": {
                            "type": "string",
                            "description": "Columns visual ID."
                          },
                          "key": {
                            "type": "string",
                            "description": "CDN key for the visual thumbnail or asset."
                          },
                          "name": {
                            "type": "string",
                            "description": "Visual name."
                          },
                          "shared": {
                            "type": "boolean",
                            "description": "Whether the visual is shared."
                          },
                          "thumb_base64": {
                            "type": "string",
                            "description": "Thumbnail URL returned by Columns."
                          },
                          "updatedAt": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Updated timestamp object from Columns."
                          },
                          "version": {
                            "type": "number",
                            "description": "Current visual schema version."
                          },
                          "versions": {
                            "type": "number",
                            "description": "Number of saved visual versions."
                          },
                          "workspaceId": {
                            "type": "string",
                            "description": "Workspace ID for the visual."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
