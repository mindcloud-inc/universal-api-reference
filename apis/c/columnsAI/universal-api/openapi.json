    "/v1/universal/columnsAI/latest/actions/publish-graph": {
      "post": {
        "operationId": "columnsAI.publish-graph",
        "summary": "Publish Graph",
        "description": "Publishes a graph to Columns AI.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/columnsAI/latest/actions/publish-graph"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "id",
                  "name",
                  "graph"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "id": {
                    "type": "string",
                    "description": "Tracking ID included in the publish request body.",
                    "example": "g-example"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name for the published Columns graph.",
                    "example": "Quarterly Sales"
                  },
                  "graph": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Columns GraphData object to publish."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
