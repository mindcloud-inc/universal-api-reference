    "/v1/universal/columnsAI/latest/actions/download-graph-image": {
      "get": {
        "operationId": "columnsAI.download-graph-image",
        "summary": "Download Graph Image",
        "description": "Downloads a graph image from Columns AI by visual ID.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/columnsAI/latest/actions/download-graph-image"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Columns visual ID whose image should be downloaded.",
            "schema": {
              "type": "string",
              "description": "Columns visual ID whose image should be downloaded.",
              "example": "U6tALuJ3cTdPFw"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
