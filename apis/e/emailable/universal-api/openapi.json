    "/v1/universal/emailable/latest/actions/create-verification-batch": {
      "post": {
        "operationId": "emailable.create-verification-batch",
        "summary": "Create Verification Batch",
        "description": "Creates an email verification batch in Emailable.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/emailable/latest/actions/create-verification-batch"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "emails"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "emails": {
                    "type": "string",
                    "description": "One or more email addresses to verify in the batch. Pass multiple values separated by `,`.",
                    "example": "alice@example.com"
                  },
                  "callbackUrl": {
                    "type": "string",
                    "description": "Optional URL that receives the completed batch result via HTTP POST.",
                    "example": "https://example.com/webhooks/emailable",
                    "x-mindcloud-advanced": true
                  },
                  "retries": {
                    "type": "boolean",
                    "description": "Leave enabled to retry certain mail-server responses for better accuracy.",
                    "x-mindcloud-advanced": true
                  },
                  "responseFields": {
                    "type": "string",
                    "description": "Optional list of per-email response fields to include in the batch result. Pass multiple values separated by `,`.",
                    "example": "email,state,score",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "The Emailable batch identifier for the newly created verification batch."
                          },
                          "message": {
                            "type": "string",
                            "description": "Confirmation message returned after the batch is created."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
