              "type": "string"
            }
          },
          {
            "name": "batchId",
            "in": "query",
            "required": true,
            "description": "The batch ID returned when you created the verification batch.",
            "schema": {
              "type": "string",
              "description": "The batch ID returned when you created the verification batch.",
              "example": "5cf6dd30093f96d2ac34bb0a"
            }
          },
          {
            "name": "partial",
            "in": "query",
            "required": false,
            "description": "Set to true to include partial results while a batch of up to 1,000 emails is still verifying.",
            "schema": {
              "type": "boolean",
              "description": "Set to true to include partial results while a batch of up to 1,000 emails is still verifying.",
              "x-mindcloud-advanced": true
            }
          },
          {
