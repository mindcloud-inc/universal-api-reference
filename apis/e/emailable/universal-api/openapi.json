                          },
                          "message": {
                            "type": "string"
                          },
                          "reasonCounts": {
                            "type": "object",
                            "properties": {
                              "acceptedEmail": {
                                "type": "number"
                              },
                              "invalidDomain": {
                                "type": "number"
                              },
                              "invalidEmail": {
