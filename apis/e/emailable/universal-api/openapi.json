    "/v1/universal/emailable/latest/actions/verify-email": {
      "get": {
        "operationId": "emailable.verify-email",
        "summary": "Verify Email",
        "description": "Verifies an email address in Emailable.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/emailable/latest/actions/verify-email"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "The email address you want Emailable to verify.",
            "schema": {
              "type": "string",
              "description": "The email address you want Emailable to verify.",
              "example": "john.smith@example.com"
            }
          },
          {
            "name": "smtp",
            "in": "query",
            "required": false,
            "description": "Set to false to skip the SMTP step and get a faster, less accurate response.",
            "schema": {
              "type": "boolean",
              "description": "Set to false to skip the SMTP step and get a faster, less accurate response.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "acceptAll",
            "in": "query",
            "required": false,
            "description": "Set to true to perform an accept-all mailbox check.",
            "schema": {
              "type": "boolean",
              "description": "Set to true to perform an accept-all mailbox check.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "description": "How many seconds to wait before Emailable returns a 249 retry-later response. Minimum 2, maximum 10.",
            "schema": {
              "type": "number",
              "description": "How many seconds to wait before Emailable returns a 249 retry-later response. Minimum 2, maximum 10.",
              "example": 5,
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "acceptAll": {
                            "type": "boolean",
                            "description": "Whether the domain appears to accept all recipient addresses."
                          },
                          "didYouMean": {
                            "type": "string",
                            "description": "A suggested corrected email address when Emailable detects a likely typo."
                          },
                          "disposable": {
                            "type": "boolean",
                            "description": "Whether the address belongs to a disposable email provider."
                          },
                          "domain": {
                            "type": "string",
                            "description": "The domain portion of the verified email address."
                          },
                          "duration": {
                            "type": "number",
                            "description": "How long the verification took, in seconds."
                          },
                          "email": {
                            "type": "string",
                            "description": "The email address that was verified."
                          },
                          "firstName": {
                            "type": "string",
                            "description": "The inferred first name associated with the email address."
                          },
                          "free": {
                            "type": "boolean",
                            "description": "Whether the address belongs to a free email provider."
                          },
                          "fullName": {
                            "type": "string",
                            "description": "The inferred full name associated with the email address."
                          },
                          "gender": {
                            "type": "string",
                            "description": "The inferred gender associated with the email address."
                          },
                          "lastName": {
                            "type": "string",
                            "description": "The inferred last name associated with the email address."
                          },
                          "mailboxFull": {
                            "type": "boolean",
                            "description": "Whether the mailbox appears to be full."
                          },
                          "mxRecord": {
                            "type": "string",
                            "description": "The MX record Emailable resolved for the domain."
                          },
                          "noReply": {
                            "type": "boolean",
                            "description": "Whether the address appears to be a no-reply mailbox."
                          },
                          "reason": {
                            "type": "string",
                            "description": "The primary reason Emailable assigned the verification outcome."
                          },
                          "role": {
                            "type": "boolean",
                            "description": "Whether the address appears to be a role-based inbox."
                          },
                          "score": {
                            "type": "number",
                            "description": "Emailable's quality score for the email address."
                          },
                          "smtpProvider": {
                            "type": "string",
                            "description": "The SMTP provider Emailable detected for the address."
                          },
                          "state": {
                            "type": "string",
                            "description": "The overall verification state returned by Emailable."
                          },
                          "tag": {
                            "type": "string",
                            "description": "The optional Emailable tag value associated with the verification."
                          },
                          "user": {
                            "type": "string",
                            "description": "The local-part user portion of the email address."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
