              "type": "string",
              "description": "Language for the intentionally insulting/offensive provider output. Defaults to English when omitted.",
              "enum": [
                "cn",
                "de",
                "el",
                "en",
                "es",
                "fr",
                "ru",
                "sw"
              ],
              "default": "en"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
