          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "active": {
                            "type": "string",
                            "description": "Provider active flag."
                          },
                          "comment": {
                            "type": "string",
                            "description": "Provider comment."
                          },
                          "created": {
                            "type": "string",
                            "description": "Provider record creation timestamp."
                          },
                          "createdby": {
                            "type": "string",
                            "description": "Provider attribution value."
                          },
                          "insult": {
                            "type": "string",
                            "description": "Generated insulting/offensive phrase."
                          },
                          "language": {
                            "type": "string",
                            "description": "Language code of the generated insult."
                          },
                          "number": {
                            "type": "string",
                            "description": "Provider record number."
                          },
                          "shown": {
                            "type": "string",
                            "description": "Provider display count."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
