  "paths": {
    "/v1/universal/exchangeRatesAPI/latest/actions/convert-currency": {
      "get": {
        "operationId": "exchangeRatesAPI.convert-currency",
        "summary": "Convert Currency",
        "description": "Converts an amount between currencies in Exchange Rates API.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/exchangeRatesAPI/latest/actions/convert-currency"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Three-letter currency code to convert from.",
            "schema": {
              "type": "string",
              "description": "Three-letter currency code to convert from.",
              "example": "USD"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Three-letter currency code to convert to.",
            "schema": {
              "type": "string",
              "description": "Three-letter currency code to convert to.",
              "example": "EUR"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": true,
            "description": "Amount to convert.",
            "schema": {
              "type": "number",
              "description": "Amount to convert.",
              "example": 25
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Optional historical conversion date in YYYY-MM-DD format.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Optional historical conversion date in YYYY-MM-DD format.",
              "example": "2024-01-15"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Date for the conversion rate data."
                          },
                          "historical": {
                            "type": "boolean",
                            "description": "Whether historical rates were used for this conversion."
                          },
                          "info": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Conversion rate metadata including timestamp and rate."
                          },
                          "query": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Conversion query details including from currency, to currency, and amount."
                          },
                          "result": {
                            "type": "number",
                            "description": "Converted amount result."
                          },
                          "success": {
                            "type": "boolean",
                            "description": "Whether the conversion request succeeded."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
