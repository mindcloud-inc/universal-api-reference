  "info": {
    "title": "Exchange Rates API Universal API",
    "version": "0.0.3",
    "description": "Exchange Rates API provides current, historical, conversion, time-series, fluctuation, and supported-currency exchange-rate data for more than 170 currencies."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
