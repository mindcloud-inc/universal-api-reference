  "paths": {
    "/v1/universal/fullSession/latest/actions/list-website-sessions": {
      "get": {
        "operationId": "fullSession.list-website-sessions",
        "summary": "List Website Sessions",
        "description": "Retrieves website visitor sessions from FullSession.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/fullSession/latest/actions/list-website-sessions"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "required": true,
            "description": "Unique customer ID from Fullsession Setup.",
            "schema": {
              "type": "string",
              "description": "Unique customer ID from Fullsession Setup."
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "description": "Unique site ID for the selected domain.",
            "schema": {
              "type": "string",
              "description": "Unique site ID for the selected domain."
            }
          },
          {
            "name": "startAfter",
            "in": "query",
            "required": false,
            "description": "Optional session timestamp in milliseconds. When provided, use the returned startAfter value to continue pagination.",
            "schema": {
              "type": "number",
              "description": "Optional session timestamp in milliseconds. When provided, use the returned startAfter value to continue pagination."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
