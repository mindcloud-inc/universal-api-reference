              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "activeTime": {
                            "type": "number"
                          },
                          "browser": {
                            "type": "string"
                          },
                          "browserFullVersion": {
                            "type": "string"
                          },
                          "city": {
                            "type": "string"
                          },
                          "country": {
                            "type": "string"
                          },
                          "countryCode": {
                            "type": "string"
                          },
                          "device": {
                            "type": "string"
                          },
                          "duration": {
                            "type": "number"
                          },
                          "endTime": {
                            "type": "number"
                          },
                          "exitPage": {
                            "type": "string"
                          },
                          "landingPage": {
                            "type": "string"
                          },
                          "os": {
                            "type": "string"
                          },
                          "pages": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "fullPath": {
                                  "type": "string"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
