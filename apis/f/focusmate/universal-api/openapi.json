{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Focusmate Universal API",
    "version": "0.0.4",
    "description": "Access Focusmate profile, partner profile, and session history data through the Focusmate Public API."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/focusmate/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/focusmate/latest/actions/get-my-profile": {
      "get": {
        "operationId": "focusmate.get-my-profile",
        "summary": "Get My Profile",
        "description": "Retrieves your personal Focusmate profile data.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/focusmate/latest/actions/get-my-profile"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "user": {
                            "type": "object",
                            "properties": {
                              "email": {
                                "type": "string",
                                "description": "Email address for the current Focusmate user."
                              },
                              "memberSince": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Date and time when the user joined Focusmate."
                              },
                              "name": {
                                "type": "string",
                                "description": "Name of the current Focusmate user."
                              },
                              "photoUrl": {
                                "type": "string",
                                "description": "Profile photo URL for the current user."
                              },
                              "timeZone": {
                                "type": "string",
                                "description": "IANA time zone for the current user."
                              },
                              "totalSessionCount": {
                                "type": "number",
                                "description": "Total number of sessions for the current user."
                              },
                              "userId": {
                                "type": "string",
                                "description": "Unique identifier for the current Focusmate user."
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
