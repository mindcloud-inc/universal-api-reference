    "/v1/universal/focusmate/latest/actions/get-sessions": {
      "get": {
        "operationId": "focusmate.get-sessions",
        "summary": "Get Sessions",
        "description": "Retrieves your Focusmate sessions within a date range.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/focusmate/latest/actions/get-sessions"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "description": "Lower limit for the date range as an ISO 8601 date-time with an offset or Z. Sessions partially within the range are included. The range must not exceed 1 year.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Lower limit for the date range as an ISO 8601 date-time with an offset or Z. Sessions partially within the range are included. The range must not exceed 1 year.",
              "example": "2026-04-01T00:00:00Z"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "description": "Upper limit for the date range as an ISO 8601 date-time with an offset or Z. Sessions partially within the range are included. The range must not exceed 1 year.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Upper limit for the date range as an ISO 8601 date-time with an offset or Z. Sessions partially within the range are included. The range must not exceed 1 year.",
              "example": "2026-04-29T23:59:59Z"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "duration": {
                            "type": "number",
                            "description": "Session duration in milliseconds."
                          },
                          "sessionId": {
                            "type": "string",
                            "description": "Unique identifier for the Focusmate session."
                          },
                          "startTime": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Session start time in UTC."
                          },
                          "users": {
                            "type": "object",
                            "properties": {
                              "activityType": {
                                "type": "string",
                                "description": "Focusmate activity type for the participant."
                              },
                              "completed": {
                                "type": "boolean",
                                "description": "Whether the participant completed the session."
                              },
                              "isFavorite": {
                                "type": "boolean",
                                "description": "Current favorite status for the non-calling user when returned."
                              },
                              "joinedAt": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Time the participant joined the session, when available."
                              },
                              "preferences": {
                                "type": "object",
                                "additionalProperties": true,
                                "description": "Participant session preferences such as quiet mode and favorite-partner preference."
                              },
                              "requestedAt": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Time the participant requested the session."
                              },
                              "sessionTitle": {
                                "type": "string",
                                "description": "Session title or task for the participant when available."
                              },
                              "userId": {
                                "type": "string",
                                "description": "Focusmate user ID for a participant."
                              }
                            },
                            "additionalProperties": false,
                            "description": "Users who participated in the session. The calling user is first."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
