    "/v1/universal/focusmate/latest/actions/get-partner-profile": {
      "get": {
        "operationId": "focusmate.get-partner-profile",
        "summary": "Get Partner Profile",
        "description": "Retrieves a user's public Focusmate profile.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/focusmate/latest/actions/get-partner-profile"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "description": "Focusmate user ID to retrieve public profile data for.",
            "schema": {
              "type": "string",
              "description": "Focusmate user ID to retrieve public profile data for.",
              "example": "5edcf2e5-539c-4250-966a-468a7ddfa38d"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "user": {
                            "type": "object",
                            "properties": {
                              "isFavorite": {
                                "type": "boolean",
                                "description": "Whether the requested user is currently a favorite partner for the calling user."
                              },
                              "name": {
                                "type": "string",
                                "description": "Name of the requested Focusmate user."
                              },
                              "photoUrl": {
                                "type": "string",
                                "description": "Profile photo URL when available."
                              },
                              "timeZone": {
                                "type": "string",
                                "description": "IANA time zone for the requested user."
                              },
                              "totalSessionCount": {
                                "type": "number",
                                "description": "Total number of sessions for the requested user."
                              },
                              "userId": {
                                "type": "string",
                                "description": "Unique identifier for the requested Focusmate user."
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
