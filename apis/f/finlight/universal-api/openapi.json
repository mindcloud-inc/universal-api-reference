      "get": {
        "operationId": "finlight.fetch-article-by-link",
        "summary": "Fetch Article By Link",
        "description": "Retrieves a single finlight article by URL.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/finlight/latest/actions/fetch-article-by-link"
        },
