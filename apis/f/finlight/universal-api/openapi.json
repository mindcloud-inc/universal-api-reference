            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "link",
            "in": "query",
            "required": true,
            "description": "Article URL to look up.",
            "schema": {
              "type": "string",
              "description": "Article URL to look up."
            }
          },
          {
            "name": "includeContent",
