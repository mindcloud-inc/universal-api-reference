                            "type": "string",
                            "description": "Language code for the article."
                          },
                          "link": {
                            "type": "string",
                            "description": "Canonical article URL."
                          },
                          "publishDate": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Article publication timestamp."
                          },
                          "source": {
                            "type": "string",
                            "description": "Source domain for the article."
                          },
                          "summary": {
                            "type": "string",
                            "description": "Article summary text."
                          },
                          "title": {
                            "type": "string",
