    "/v1/universal/filestack/latest/actions/store-file-from-url": {
      "post": {
        "operationId": "filestack.store-file-from-url",
        "summary": "Store File From URL",
        "description": "Creates a new file in Filestack from a URL.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/filestack/latest/actions/store-file-from-url"
        },
        "security": [
          {
            "bearerAuth": []
