                "type": "object",
                "required": [
                  "connectionId",
                  "url"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "filename": {
                    "type": "string",
                    "description": "Optional filename to store in Filestack.",
                    "example": "watermark.png"
                  },
                  "mimeType": {
                    "type": "string",
                    "description": "Optional MIME type override, for example image/png.",
                    "example": "image/png",
                    "x-mindcloud-advanced": true
                  },
                  "url": {
                    "type": "string",
                    "description": "Public URL of the file to import into Filestack.",
                    "example": "https://assets.filestackapi.com/watermark.png",
                    "default": "https://assets.filestackapi.com/watermark.png"
                  }
                },
                "additionalProperties": false
              }
            }
