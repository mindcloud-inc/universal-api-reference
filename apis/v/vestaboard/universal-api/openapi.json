    "/v1/universal/vestaboard/latest/actions/send-message": {
      "post": {
        "operationId": "vestaboard.send-message",
        "summary": "Send Message",
        "description": "Sends a new message to Vestaboard.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/vestaboard/latest/actions/send-message"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "text": {
                    "type": "string",
                    "description": "Plain-text message to show on the Vestaboard."
                  },
                  "characters[]": {
                    "type": "array",
                    "items": {},
                    "description": "Two-dimensional array of Vestaboard character codes."
                  },
                  "forced": {
                    "type": "boolean",
                    "description": "Override quiet hours when true."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "created": {
                            "type": "number",
                            "description": "Unix timestamp in milliseconds when the message was created."
                          },
                          "id": {
                            "type": "string",
                            "description": "Identifier of the created message."
                          },
                          "status": {
