    "/v1/universal/vestaboard/latest/actions/set-transition": {
      "put": {
        "operationId": "vestaboard.set-transition",
        "summary": "Set Transition",
        "description": "Updates transition settings in Vestaboard.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/vestaboard/latest/actions/set-transition"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "transition",
                  "transitionSpeed"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "transition": {
                    "type": "string",
                    "description": "Transition style to apply.",
                    "enum": [
                      "classic",
                      "curtain",
                      "drift",
                      "wave"
                    ]
                  },
                  "transitionSpeed": {
                    "type": "string",
                    "description": "Transition speed to apply.",
                    "enum": [
                      "fast",
                      "gentle"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
