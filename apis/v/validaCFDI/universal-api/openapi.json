    "/v1/universal/validaCFDI/latest/actions/validate-cfdi-from-pdf": {
      "get": {
        "operationId": "validaCFDI.validate-cfdi-from-pdf",
        "summary": "Validate CFDI from PDF",
        "description": "Validates a CFDI from a PDF in ValidaCFDI.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/validaCFDI/latest/actions/validate-cfdi-from-pdf"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file",
            "in": "query",
            "required": true,
            "description": "PDF invoice file to validate and extract.",
            "schema": {
              "type": "string",
              "description": "PDF invoice file to validate and extract."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "efosCheck": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "EFOS risk check result when available."
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Errors returned during PDF processing."
                          },
                          "extractionData": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Structured data extracted from the PDF.",
                            "properties": {
                              "customerName": {
                                "type": "string",
                                "description": "Extracted customer name when present."
                              },
                              "extractionWarnings": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Warnings raised during OCR extraction."
                              },
                              "invoiceDate": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Extracted invoice date when present."
                              },
                              "lineItems": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": true
                                },
                                "description": "Extracted line items when identified."
                              },
                              "ocrConfidence": {
                                "type": "number",
                                "description": "OCR confidence score for the extraction."
                              },
                              "rfcEmisor": {
                                "type": "string",
                                "description": "Extracted issuer RFC when present."
                              },
                              "rfcReceptor": {
                                "type": "string",
                                "description": "Extracted receiver RFC when present."
                              },
                              "supplierName": {
                                "type": "string",
                                "description": "Extracted supplier name."
                              },
                              "total": {
                                "type": "number",
                                "description": "Extracted invoice total when present."
                              },
                              "uuid": {
                                "type": "string",
                                "description": "Extracted CFDI UUID when present."
                              }
                            }
                          },
                          "extractionSuccess": {
                            "type": "boolean",
                            "description": "Whether PDF extraction completed successfully."
                          },
                          "overallStatus": {
                            "type": "string",
                            "description": "Overall extraction and validation status."
                          },
                          "processingTimeMs": {
                            "type": "number",
                            "description": "Time spent processing the PDF in milliseconds."
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Timestamp of the PDF processing result."
                          },
                          "validationPerformed": {
                            "type": "boolean",
                            "description": "Whether a CFDI validation step was performed after extraction."
                          },
                          "validationResult": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Nested validation result when validation is performed."
                          },
                          "verificationSuggestions": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Suggested follow-up checks when available."
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Warnings returned during PDF processing."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
