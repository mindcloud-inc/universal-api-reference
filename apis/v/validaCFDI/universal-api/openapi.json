    "/v1/universal/validaCFDI/latest/actions/validate-cfdi-by-uuid": {
      "get": {
        "operationId": "validaCFDI.validate-cfdi-by-uuid",
        "summary": "Validate CFDI by UUID",
        "description": "Validates a CFDI by UUID in ValidaCFDI.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/validaCFDI/latest/actions/validate-cfdi-by-uuid"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "description": "CFDI UUID to validate.",
            "schema": {
              "type": "string",
              "description": "CFDI UUID to validate."
            }
          },
          {
            "name": "rfcEmisor",
            "in": "query",
            "required": true,
            "description": "RFC of the CFDI issuer.",
            "schema": {
              "type": "string",
              "description": "RFC of the CFDI issuer."
            }
          },
          {
            "name": "rfcReceptor",
            "in": "query",
            "required": true,
            "description": "RFC of the CFDI receiver.",
            "schema": {
              "type": "string",
              "description": "RFC of the CFDI receiver."
            }
          },
          {
            "name": "total",
            "in": "query",
            "required": true,
            "description": "Total invoice amount for validation.",
            "schema": {
              "type": "number",
              "description": "Total invoice amount for validation."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cfdiData": {
                            "type": "object",
                            "additionalProperties": false,
                            "description": "Structured CFDI validation details.",
                            "properties": {
                              "codigoEstatus": {
                                "type": "string",
                                "description": "Provider status code and message."
                              },
                              "esCancelable": {
                                "type": "string",
                                "description": "Whether the CFDI can be cancelled."
                              },
                              "estadoCancelacion": {
                                "type": "string",
                                "description": "Cancellation status when available."
                              },
                              "estadoCfdi": {
                                "type": "string",
                                "description": "SAT CFDI status."
                              },
                              "rfcEmisor": {
                                "type": "string",
                                "description": "RFC of the invoice issuer from successful validation payloads."
                              },
                              "rfcReceptor": {
                                "type": "string",
                                "description": "RFC of the invoice receiver from successful validation payloads."
                              },
                              "total": {
                                "type": "number",
                                "description": "Invoice total from successful validation payloads."
                              },
                              "uuid": {
                                "type": "string",
                                "description": "CFDI UUID that was validated."
                              }
                            }
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Validation errors when the CFDI could not be confirmed."
                          },
                          "status": {
                            "type": "string",
                            "description": "Validation status returned by the provider."
                          },
                          "valid": {
                            "type": "boolean",
                            "description": "Whether the CFDI validation succeeded."
                          },
                          "validationTimestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Timestamp of the validation result."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
