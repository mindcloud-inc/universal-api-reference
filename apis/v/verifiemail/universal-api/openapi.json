                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Published DMARC records."
                              },
                              "score": {
                                "type": "number",
                                "description": "Current DMARC score."
                              },
                              "target_score": {
                                "type": "number",
                                "description": "Recommended DMARC target score."
                              }
                            },
                            "additionalProperties": false
                          },
                          "domain": {
                            "type": "string",
                            "description": "Domain that was inspected."
                          },
