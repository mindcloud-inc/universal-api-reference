                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bimi": {
                            "type": "object",
                            "properties": {
                              "exists": {
                                "type": "boolean",
                                "description": "Whether a BIMI record exists."
                              },
                              "recommendation": {
                                "type": "string",
                                "description": "Improvement guidance for BIMI."
                              },
                              "records": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Published BIMI records."
                              },
                              "score": {
                                "type": "number",
                                "description": "Current BIMI score."
                              },
                              "target_score": {
                                "type": "number",
                                "description": "Recommended BIMI target score."
                              }
                            },
                            "additionalProperties": false
                          },
                          "dkim": {
                            "type": "object",
                            "properties": {
                              "exists": {
                                "type": "boolean",
                                "description": "Whether a DKIM record exists for the selector."
                              },
                              "recommendation": {
                                "type": "string",
                                "description": "Improvement guidance for DKIM."
                              },
                              "records": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Published DKIM records."
                              },
                              "score": {
                                "type": "number",
                                "description": "Current DKIM score."
                              },
                              "target_score": {
                                "type": "number",
                                "description": "Recommended DKIM target score."
                              }
                            },
                            "additionalProperties": false
                          },
                          "dmarc": {
                            "type": "object",
                            "properties": {
                              "exists": {
                                "type": "boolean",
                                "description": "Whether a DMARC record exists."
                              },
                              "policy": {
                                "type": "string",
                                "description": "Observed DMARC enforcement policy."
                              },
                              "recommendation": {
                                "type": "string",
                                "description": "Improvement guidance for DMARC."
