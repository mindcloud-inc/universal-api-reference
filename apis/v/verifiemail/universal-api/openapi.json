              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "details": {
                            "type": "object",
                            "properties": {
                              "disposable": {
                                "type": "boolean",
                                "description": "Whether the address belongs to a disposable provider."
                              },
                              "mx": {
                                "type": "object",
                                "properties": {
                                  "provider": {
                                    "type": "string",
                                    "description": "Detected mail provider for the domain."
                                  },
                                  "records": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "description": "Resolved MX records for the domain."
                                  }
                                },
                                "additionalProperties": false
                              },
                              "rfcCompliant": {
                                "type": "boolean",
                                "description": "Whether the address matches RFC syntax rules."
                              },
                              "spoofFree": {
                                "type": "boolean",
                                "description": "Whether the address appears resistant to spoofing checks."
                              },
                              "validMxRecord": {
                                "type": "boolean",
                                "description": "Whether the domain has valid MX records."
                              }
                            },
                            "additionalProperties": false
                          },
                          "email": {
                            "type": "string",
                            "description": "Email address that was checked."
                          },
                          "valid": {
                            "type": "boolean",
                            "description": "Whether the address appears valid and deliverable."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
