              "type": "string",
              "description": "A public website URL to scan instead of raw text.",
              "example": "https://example.com/article",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "excludedSources[]",
            "in": "query",
            "required": false,
            "description": "Domains or URLs to exclude from the plagiarism score.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Domains or URLs to exclude from the plagiarism score.",
              "x-mindcloud-advanced": true
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Two-letter language code, or auto for auto-detection.",
            "schema": {
              "type": "string",
              "description": "Two-letter language code, or auto for auto-detection.",
              "example": "auto",
              "default": "auto"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country code to guide the scan context.",
            "schema": {
              "type": "string",
              "description": "Country code to guide the scan context.",
              "example": "us",
              "default": "us"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "attackDetected": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Indicators for zero-width-space and homoglyph attacks."
                          },
                          "citations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Detected citations in the provided text."
                          },
                          "credits_remaining": {
                            "type": "number",
                            "description": "Remaining Winston AI credits after the scan."
                          },
                          "credits_used": {
                            "type": "number",
                            "description": "Credits consumed by the scan."
                          },
                          "indexes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Plagiarism sequence ranges found in the input text."
                          },
                          "result": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Overall plagiarism scan summary metrics."
                          },
                          "scanInformation": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Metadata about the plagiarism scan request."
                          },
                          "similarWords": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Similar words identified in the input text."
                          },
                          "sources": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Matched sources found during the scan."
                          },
                          "status": {
                            "type": "number",
                            "description": "HTTP status code returned by Winston AI."
                          },
                          "text": {
                            "type": "string",
                            "description": "Input text used for the plagiarism scan."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
