    "/v1/universal/winstonAI/latest/actions/detect-ai-image": {
      "get": {
        "operationId": "winstonAI.detect-ai-image",
        "summary": "Detect AI Image",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/winstonAI/latest/actions/detect-ai-image"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Public image URL to scan for AI generation signals.",
            "schema": {
              "type": "string",
              "description": "Public image URL to scan for AI generation signals.",
              "example": "https://example.com/image.jpg"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "The Winston AI image model version to use.",
            "schema": {
              "type": "string",
              "description": "The Winston AI image model version to use.",
              "example": "latest"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ai_probability": {
                            "type": "number",
                            "description": "Probability that the image was created by AI."
                          },
                          "ai_watermark_detected": {
                            "type": "boolean",
                            "description": "Whether an AI watermark was detected."
                          },
                          "ai_watermark_issuers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Detected AI watermark issuers."
                          },
                          "c2pa": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "C2PA provenance metadata when present."
                          },
                          "credits_remaining": {
                            "type": "number",
                            "description": "Remaining Winston AI credits after the scan."
                          },
                          "credits_used": {
                            "type": "number",
                            "description": "Credits consumed by the image scan."
                          },
                          "exif": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Extracted EXIF and related image metadata."
                          },
                          "human_probability": {
                            "type": "number",
                            "description": "Probability that the image was created by a human."
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Technical image metadata such as dimensions and format."
                          },
                          "mime_type": {
                            "type": "string",
                            "description": "Mime type of the analyzed image."
                          },
                          "score": {
                            "type": "number",
                            "description": "Human-likelihood score for the scanned image."
                          },
                          "version": {
                            "type": "string",
                            "description": "Image model version used for the prediction."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
