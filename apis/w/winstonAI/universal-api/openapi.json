{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Winston AI Universal API",
    "version": "0.0.6",
    "description": "Detect AI text, plagiarism, facts, images, and text similarity"
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/winstonAI/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/winstonAI/latest/actions/check-facts": {
      "get": {
        "operationId": "winstonAI.check-facts",
        "summary": "Check Facts",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/winstonAI/latest/actions/check-facts"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "text",
            "in": "query",
            "required": true,
            "description": "The text to fact-check.",
            "schema": {
              "type": "string",
              "description": "The text to fact-check.",
              "example": "Paste at least 300 characters of text to fact-check"
            }
          },
          {
            "name": "file",
            "in": "query",
            "required": false,
            "description": "A public PDF, DOC, or DOCX URL to fact-check instead of raw text.",
            "schema": {
              "type": "string",
              "description": "A public PDF, DOC, or DOCX URL to fact-check instead of raw text.",
              "example": "https://example.com/file.pdf",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "website",
            "in": "query",
            "required": false,
            "description": "A public website URL to fact-check instead of raw text.",
            "schema": {
              "type": "string",
              "description": "A public website URL to fact-check instead of raw text.",
              "example": "https://example.com/article",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Two-letter language code, or auto for auto-detection.",
            "schema": {
              "type": "string",
              "description": "Two-letter language code, or auto for auto-detection.",
              "example": "auto",
              "default": "auto"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "claims": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Extracted claims and their fact-check results."
                          },
                          "claimsCount": {
                            "type": "number",
                            "description": "Number of claims extracted from the text."
                          },
                          "creditsRemaining": {
                            "type": "number",
                            "description": "Remaining Winston AI credits after the request."
                          },
                          "creditsUsed": {
                            "type": "number",
                            "description": "Credits consumed by the fact-check request."
                          },
                          "input": {
                            "type": "string",
                            "description": "Input mode used by the request."
                          },
                          "language": {
                            "type": "string",
                            "description": "Detected or specified language code."
                          },
                          "score": {
                            "type": "number",
                            "description": "Overall factual-accuracy score for the input text."
                          },
                          "sentences": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Sentences extracted from the analyzed text."
                          },
                          "status": {
                            "type": "number",
                            "description": "HTTP status code returned by Winston AI."
                          },
                          "text": {
                            "type": "string",
                            "description": "Original text analyzed by the fact checker."
                          },
                          "wordCount": {
                            "type": "number",
                            "description": "Word count of the analyzed input."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/winstonAI/latest/actions/check-plagiarism": {
      "get": {
        "operationId": "winstonAI.check-plagiarism",
        "summary": "Check Plagiarism",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/winstonAI/latest/actions/check-plagiarism"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "text",
            "in": "query",
            "required": true,
            "description": "The text to scan for plagiarism.",
            "schema": {
              "type": "string",
              "description": "The text to scan for plagiarism.",
              "example": "Paste at least 100 characters of text to scan"
            }
          },
          {
            "name": "file",
            "in": "query",
            "required": false,
            "description": "A public PDF, DOC, or DOCX URL to scan instead of raw text.",
            "schema": {
              "type": "string",
              "description": "A public PDF, DOC, or DOCX URL to scan instead of raw text.",
              "example": "https://example.com/file.pdf",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "website",
            "in": "query",
            "required": false,
            "description": "A public website URL to scan instead of raw text.",
