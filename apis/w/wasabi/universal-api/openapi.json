            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bucketName",
            "in": "query",
            "required": true,
            "description": "Name of the bucket to list objects from.",
            "schema": {
              "type": "string",
              "description": "Name of the bucket to list objects from.",
              "example": "mindcloud-wasabi-agent-20260422-1214"
            }
          },
          {
