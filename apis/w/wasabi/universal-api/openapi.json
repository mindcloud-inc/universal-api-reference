              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "location": {
                            "type": "string",
                            "description": "Provider location path for the created bucket."
                          },
                          "name": {
                            "type": "string",
                            "description": "Created bucket name."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
