    "/v1/universal/what3Words/latest/actions/suggest-what3words-addresses": {
      "get": {
        "operationId": "what3Words.suggest-what3words-addresses",
        "summary": "Suggest what3words Addresses",
        "description": "Finds suggested what3words addresses from text input.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/what3Words/latest/actions/suggest-what3words-addresses"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "input",
            "in": "query",
            "required": true,
            "description": "Full or partial what3words address. At minimum, use the first two complete words plus one character from the third word.",
            "schema": {
              "type": "string",
              "description": "Full or partial what3words address. At minimum, use the first two complete words plus one character from the third word.",
              "example": "filled.count.s"
            }
          },
          {
            "name": "focus",
            "in": "query",
            "required": false,
            "description": "Latitude and longitude used to prioritize nearby suggestions, for example 51.521251,-0.203586.",
            "schema": {
              "type": "string",
              "description": "Latitude and longitude used to prioritize nearby suggestions, for example 51.521251,-0.203586.",
              "example": "51.521251,-0.203586"
            }
          },
          {
            "name": "nResults",
            "in": "query",
            "required": false,
            "description": "Number of suggestions to return. Values over 100 are truncated to 100.",
            "schema": {
              "type": "number",
              "description": "Number of suggestions to return. Values over 100 are truncated to 100.",
              "example": 3,
              "default": 3
            }
          },
          {
            "name": "nFocusResults",
            "in": "query",
            "required": false,
            "description": "Number of top suggestions strongly biased toward the focus coordinate.",
            "schema": {
