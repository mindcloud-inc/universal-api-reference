  "info": {
    "title": "What3Words Universal API",
    "version": "0.0.2",
    "description": "Convert between what3words addresses and geographic coordinates, suggest valid three-word addresses, inspect grid sections, and list supported address languages."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/what3Words/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/what3Words/latest/actions/convert-coordinates-to-what3words-address": {
      "get": {
        "operationId": "what3Words.convert-coordinates-to-what3words-address",
        "summary": "Convert Coordinates to what3words Address",
        "description": "Retrieves a what3words address from coordinates.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/what3Words/latest/actions/convert-coordinates-to-what3words-address"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "coordinates",
            "in": "query",
            "required": true,
            "description": "Latitude and longitude separated by a comma, for example 51.521251,-0.203586.",
            "schema": {
              "type": "string",
              "description": "Latitude and longitude separated by a comma, for example 51.521251,-0.203586.",
              "example": "51.521251,-0.203586"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Supported what3words language code. Defaults to English when omitted.",
            "schema": {
              "type": "string",
              "description": "Supported what3words language code. Defaults to English when omitted.",
              "example": "en",
              "default": "en"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format: json or geojson.",
            "schema": {
              "type": "string",
              "description": "Response format: json or geojson.",
              "enum": [
                "geojson",
                "json"
              ],
              "example": "json",
              "default": "json",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Optional locale or script-specific code such as mn_la, zh_tr, or oo_la.",
            "schema": {
              "type": "string",
              "description": "Optional locale or script-specific code such as mn_la, zh_tr, or oo_la.",
              "example": "mn_la",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "coordinates": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Latitude and longitude of the square center."
                          },
                          "country": {
                            "type": "string",
                            "description": "ISO 3166-1 alpha-2 country code."
                          },
                          "language": {
                            "type": "string",
                            "description": "Language code of the returned address."
                          },
                          "locale": {
                            "type": "string",
                            "description": "Locale of the returned address, when applicable."
                          },
                          "map": {
                            "type": "string",
                            "description": "URL to view the address on the what3words map."
                          },
                          "nearestPlace": {
                            "type": "string",
                            "description": "Nearest place to the what3words address."
                          },
                          "square": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Bounds of the 3m x 3m square."
                          },
                          "words": {
                            "type": "string",
                            "description": "The what3words address."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
