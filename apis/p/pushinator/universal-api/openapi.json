        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "channelId",
                  "content"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "channelId": {
                    "type": "string",
                    "description": "The Pushinator channel ID that will receive the notification."
                  },
                  "content": {
                    "type": "string",
                    "description": "The notification text to send."
                  },
                  "acknowledgmentRequired": {
                    "type": "boolean",
                    "description": "Whether subscribers must acknowledge the notification.",
                    "default": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
