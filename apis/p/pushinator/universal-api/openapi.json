    "/v1/universal/pushinator/latest/actions/send-notification": {
      "post": {
        "operationId": "pushinator.send-notification",
        "summary": "Send Notification",
        "description": "Creates a new notification in a Pushinator channel.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/pushinator/latest/actions/send-notification"
        },
        "security": [
          {
            "bearerAuth": []
