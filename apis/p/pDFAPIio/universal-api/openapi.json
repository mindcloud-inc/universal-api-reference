                          "teamId": {
                            "type": "number",
                            "description": "The unique identifier of the team that owns the template."
                          },
                          "teamName": {
                            "type": "string",
                            "description": "The name of the team that owns the template."
                          },
                          "type": {
                            "type": "string",
                            "description": "The type of the template, such as editor or html."
