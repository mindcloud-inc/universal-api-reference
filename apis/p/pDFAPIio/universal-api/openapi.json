    "/v1/universal/pDFAPIio/latest/actions/merge-templates": {
      "post": {
        "operationId": "pDFAPIio.merge-templates",
        "summary": "Merge Templates",
        "description": "Creates one PDF document from multiple templates in PDF-API.io.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/pDFAPIio/latest/actions/merge-templates"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "templates[]",
                  "templates[].id",
                  "templates[].data"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "templates[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "The ordered list of templates to merge into a single PDF."
                  },
                  "templates[].id": {
                    "type": "string",
                    "description": "The identifier of the template to merge."
                  },
                  "templates[].data": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Key-value pairs representing the data to replace in that template before merging."
                  },
                  "output": {
                    "type": "string",
                    "description": "Optional output format for the merged PDF response.",
                    "enum": [
                      "pdf",
                      "url"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "number",
                            "description": "The HTTP-style status returned by PDF-API.io for the merged PDF request."
                          },
                          "url": {
                            "type": "string",
                            "description": "The temporary download URL for the merged PDF when output=url is used."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
