    "/v1/universal/peakIDX/latest/actions/list-search-results": {
      "get": {
        "operationId": "peakIDX.list-search-results",
        "summary": "List Search Results",
        "description": "Retrieves listings for a saved search in PeakIDX.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/peakIDX/latest/actions/list-search-results"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchEmbedId",
            "in": "query",
            "required": true,
            "description": "The saved search embed identifier from the PeakIDX Search Embeds page.",
            "schema": {
              "type": "string",
              "description": "The saved search embed identifier from the PeakIDX Search Embeds page."
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Starting position for the results. PeakIDX docs allow values from 0 through 10000.",
            "schema": {
              "type": "number",
              "description": "Starting position for the results. PeakIDX docs allow values from 0 through 10000.",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results to return. PeakIDX docs allow values from 0 through 200.",
            "schema": {
              "type": "number",
              "description": "Maximum number of results to return. PeakIDX docs allow values from 0 through 200.",
              "default": 10
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
