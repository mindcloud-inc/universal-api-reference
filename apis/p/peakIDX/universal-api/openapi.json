    "/v1/universal/peakIDX/latest/actions/create-or-update-lead": {
      "post": {
        "operationId": "peakIDX.create-or-update-lead",
        "summary": "Create Or Update Lead",
        "description": "Creates or updates a lead in PeakIDX.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/peakIDX/latest/actions/create-or-update-lead"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "leadId": {
                    "type": "string",
                    "description": "Unique identifier for the lead."
                  },
                  "leadType": {
                    "type": "string",
                    "description": "Lead category such as Inquiry, Property Inquiry, CMA Inquiry, or Mortgage Quote."
                  },
                  "leadFirstName": {
                    "type": "string",
                    "description": "Lead given name."
                  },
                  "leadLastName": {
                    "type": "string",
                    "description": "Lead family name."
                  },
                  "leadEmail": {
                    "type": "string",
                    "description": "Primary lead email address."
                  },
                  "leadPhone": {
                    "type": "string",
                    "description": "Primary lead phone number."
                  },
                  "leadComments": {
                    "type": "string",
                    "description": "Additional notes or context for the lead."
                  },
                  "leadListingId": {
                    "type": "string",
                    "description": "Associated listing identifier such as an MLS number."
                  },
                  "leadPhone2": {
                    "type": "string",
                    "description": "Secondary lead phone number."
                  },
                  "leadCreatedDatetime": {
                    "type": "string",
                    "description": "Lead creation timestamp in PeakIDX format such as 2024-03-22 12:00:00."
                  },
                  "leadCustomFields": {
                    "type": "string",
                    "description": "Multi-line custom field text formatted as Label: Value pairs."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean",
                            "description": "Whether PeakIDX accepted the lead upsert request."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
