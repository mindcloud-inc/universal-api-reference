    "/v1/universal/piAPIMMAudio/latest/actions/generate-audio": {
      "post": {
        "operationId": "piAPIMMAudio.generate-audio",
        "summary": "Generate Audio",
        "description": "Creates an MMAudio audio generation task in PiAPI/MMAudio.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/piAPIMMAudio/latest/actions/generate-audio"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "input.video"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "input.video": {
                    "type": "string",
                    "description": "Public video URL to send to PiAPI MMAudio.",
                    "example": "https://example.com/video.mp4"
                  },
                  "input.prompt": {
                    "type": "string",
                    "example": "energetic stadium ambience with crowd cheers"
                  },
                  "input.negativePrompt": {
                    "type": "string",
                    "example": "static, clipping, muffled audio",
                    "x-mindcloud-advanced": true
                  },
                  "input.steps": {
                    "type": "number",
                    "example": 20,
                    "default": 20,
                    "x-mindcloud-advanced": true
                  },
                  "input.seed": {
                    "type": "number",
                    "example": 48511119825268,
                    "x-mindcloud-advanced": true
                  },
                  "config.webhookConfig.endpoint": {
                    "type": "string",
                    "example": "https://example.com/piapi-webhook",
                    "x-mindcloud-advanced": true
                  },
                  "config.webhookConfig.secret": {
                    "type": "string",
                    "example": "shared-secret-for-webhook-verification",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "error": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "number"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          },
                          "meta": {
                            "type": "object",
                            "properties": {
                              "createdAt": {
                                "type": "string"
                              },
                              "endedAt": {
                                "type": "string"
                              },
                              "isUsingPrivatePool": {
                                "type": "boolean"
                              },
                              "startedAt": {
                                "type": "string"
                              },
                              "usage": {
                                "type": "object",
                                "properties": {
                                  "consume": {
                                    "type": "number"
                                  },
                                  "frozen": {
                                    "type": "number"
                                  },
                                  "type": {
                                    "type": "string"
                                  }
                                },
                                "additionalProperties": false
                              }
                            },
                            "additionalProperties": false
                          },
                          "model": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "taskId": {
                            "type": "string"
                          },
                          "taskType": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
