            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "taskId",
            "in": "query",
            "required": true,
            "description": "The PiAPI task_id returned when you create the MMAudio task.",
            "schema": {
              "type": "string",
              "description": "The PiAPI task_id returned when you create the MMAudio task.",
              "example": "task identifier returned by Generate Audio"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
