            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "teamName",
            "in": "query",
            "required": true,
            "description": "Exact Pagerly team name to resolve to a Jira accountId.",
            "schema": {
              "type": "string",
              "description": "Exact Pagerly team name to resolve to a Jira accountId.",
              "example": "Select a Pagerly team"
            }
