      "get": {
        "operationId": "rijksoverheid.get-school-holidays-by-school-year",
        "summary": "Get School Holidays By School Year",
        "description": "Retrieves school holidays for a school year from Rijksoverheid.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/rijksoverheid/latest/actions/get-school-holidays-by-school-year"
        },
        "security": [
