            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schoolYear",
            "in": "query",
            "required": true,
            "description": "School year to retrieve in YYYY-YYYY format, for example 2029-2030.",
            "schema": {
              "type": "string",
              "description": "School year to retrieve in YYYY-YYYY format, for example 2029-2030.",
              "example": "2029-2030",
              "default": "2029-2030"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
