          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "authorities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Responsible government authority names."
                          },
                          "canonical": {
                            "type": "string",
                            "description": "Canonical Rijksoverheid page URL for the requested school-year holiday overview."
                          },
                          "content": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "School-year holiday content, including title, school year, and vacation periods."
                          },
                          "creators": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Creator organization names."
                          },
                          "id": {
                            "type": "string",
                            "description": "Unique identifier for the school holiday data record."
                          },
                          "language": {
                            "type": "string",
                            "description": "Language tag for the response data."
                          },
                          "lastmodified": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Last modified timestamp for the record."
                          },
                          "license": {
                            "type": "string",
                            "description": "Reuse license for the data."
                          },
                          "location": {
                            "type": "string",
                            "description": "Geographic location for the data."
                          },
                          "notice": {
                            "type": "string",
                            "description": "Additional notice text from Rijksoverheid about advisory or compulsory dates."
                          },
                          "rightsholders": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Organizations that hold or manage the rights."
                          },
                          "type": {
                            "type": "string",
                            "description": "Information type returned by Rijksoverheid."
                          }
                        },
                        "additionalProperties": false
