    "/v1/universal/realtorcom/latest/actions/list-properties": {
      "get": {
        "operationId": "realtorcom.list-properties",
        "summary": "List Properties",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/realtorcom/latest/actions/list-properties"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Optional OData filter expression. ListHub documents supported fields including PropertyType, ListingId, ModificationTimestamp, StandardStatus, SourceSystemID, PostalCode, Country, ListingKey, ListPrice, PropertySubType, StateOrProvince, and TransactionType.",
            "schema": {
              "type": "string",
              "description": "Optional OData filter expression. ListHub documents supported fields including PropertyType, ListingId, ModificationTimestamp, StandardStatus, SourceSystemID, PostalCode, Country, ListingKey, ListPrice, PropertySubType, StateOrProvince, and TransactionType.",
              "example": "StandardStatus eq 'Active'"
            }
          },
          {
            "name": "select",
            "in": "query",
            "required": false,
            "description": "Comma-separated RESO field names to return, for example ListingKey,StandardStatus,ListPrice.",
            "schema": {
              "type": "string",
              "description": "Comma-separated RESO field names to return, for example ListingKey,StandardStatus,ListPrice.",
              "example": "ListingKey,StandardStatus,ListPrice"
            }
          },
          {
            "name": "orderby",
            "in": "query",
            "required": false,
            "description": "Optional OData order expression. ListHub documents ordering on ListingKey and ModificationTimestamp only.",
            "schema": {
              "type": "string",
              "description": "Optional OData order expression. ListHub documents ordering on ListingKey and ModificationTimestamp only.",
              "example": "ListingKey asc",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Set true to request an @odata.count value when supported for the query.",
            "schema": {
              "type": "boolean",
              "description": "Set true to request an @odata.count value when supported for the query.",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "@odata": {
                            "type": "object",
                            "properties": {
                              "context": {
                                "type": "string",
                                "description": "OData context URL for the property collection response."
                              },
                              "count": {
                                "type": "number",
                                "description": "Total matching property count when $count=true is requested."
                              },
                              "nextLink": {
                                "type": "string",
                                "description": "OData URL for the next page when more property records are available."
                              }
                            },
                            "additionalProperties": false
                          },
                          "value": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Array of Property records returned by ListHub. Fields depend on $select and include ListingKey, ListingId, PropertyType, PropertySubType, StandardStatus, ListPrice, UnparsedAddress, and ModificationTimestamp in the verified projection."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
