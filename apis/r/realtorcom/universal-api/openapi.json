    "/v1/universal/realtorcom/latest/actions/get-property": {
      "get": {
        "operationId": "realtorcom.get-property",
        "summary": "Get Property",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/realtorcom/latest/actions/get-property"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "listingKey",
            "in": "query",
            "required": true,
            "description": "Unique ListHub ListingKey, for example 3yd-FAKE-1.",
            "schema": {
              "type": "string",
              "description": "Unique ListHub ListingKey, for example 3yd-FAKE-1.",
              "example": "3yd-FAKE-1"
            }
          },
          {
            "name": "select",
            "in": "query",
            "required": false,
            "description": "Comma-separated RESO field names to return for the listing.",
            "schema": {
              "type": "string",
              "description": "Comma-separated RESO field names to return for the listing.",
              "example": "ListingKey,StandardStatus,ListPrice"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "@odata": {
                            "type": "object",
                            "properties": {
                              "context": {
                                "type": "string",
                                "description": "OData context URL for the single Property response."
                              },
                              "id": {
                                "type": "string",
                                "description": "OData entity self-link for the property record."
                              }
                            },
                            "additionalProperties": false
                          },
                          "ListingId": {
                            "type": "string",
                            "description": "Listing identifier from the source feed."
                          },
                          "ListingKey": {
                            "type": "string",
                            "description": "Unique ListHub listing key used as the primary identifier."
                          },
                          "ListPrice": {
                            "type": "number",
                            "description": "Listing price."
                          },
                          "ModificationTimestamp": {
                            "type": "string",
                            "description": "Last modification timestamp for the property record."
                          },
                          "PropertySubType": {
                            "type": "string",
                            "description": "Property subtype."
                          },
                          "PropertyType": {
                            "type": "string",
                            "description": "High-level property type."
                          },
                          "StandardStatus": {
                            "type": "string",
                            "description": "Standard listing status."
                          },
                          "UnparsedAddress": {
                            "type": "string",
                            "description": "Display address when available from the feed."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
