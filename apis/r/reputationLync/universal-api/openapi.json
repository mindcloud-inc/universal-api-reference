  "paths": {
    "/v1/universal/reputationLync/latest/actions/add-customer": {
      "post": {
        "operationId": "reputationLync.add-customer",
        "summary": "Add Customer",
        "description": "Creates a new customer in ReputationLync.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/reputationLync/latest/actions/add-customer"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "customerName"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "customerName": {
                    "type": "string",
                    "description": "Name of the customer to add.",
                    "example": "Jane Doe"
                  },
                  "emailId": {
                    "type": "string",
                    "description": "Customer email address. Provide this or Phone Number.",
                    "example": "jane.doe@example.com"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Customer phone number. Provide this or Email ID.",
                    "example": "855-555-1234"
                  },
                  "whatsappEnabled": {
                    "type": "string",
                    "description": "Use 1 if the phone number is WhatsApp-enabled, otherwise 0.",
                    "example": "1",
                    "x-mindcloud-advanced": true
                  },
                  "tags": {
                    "type": "string",
                    "description": "Comma-separated tags to associate with the customer.",
                    "example": "retail,online",
                    "x-mindcloud-advanced": true
                  },
                  "language": {
                    "type": "string",
                    "description": "Language configured in ReputationLync for this customer.",
                    "example": "English",
                    "x-mindcloud-advanced": true
                  },
                  "source": {
                    "type": "string",
                    "description": "Source label for this customer creation.",
                    "example": "API",
                    "default": "API",
                    "x-mindcloud-advanced": true
                  },
                  "sourceXrefId": {
                    "type": "string",
                    "description": "External customer or transaction ID from the source system.",
                    "example": "order-1001",
                    "x-mindcloud-advanced": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "customerDatesNotes": {
                            "type": "string",
                            "description": "Provider notes related to customer date handling."
                          },
                          "customerId": {
                            "type": "number",
                            "description": "Customer identifier created by ReputationLync."
                          },
                          "result": {
                            "type": "string",
                            "description": "Result message returned by ReputationLync."
                          },
                          "skipRatingRequest": {
                            "type": "boolean",
                            "description": "Whether the provider skipped the rating request flow for the new customer."
                          },
                          "status": {
                            "type": "string",
                            "description": "Provider status for the add-customer request."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
