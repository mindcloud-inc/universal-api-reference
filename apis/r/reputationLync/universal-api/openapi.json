    "/v1/universal/reputationLync/latest/actions/list-customers": {
      "get": {
        "operationId": "reputationLync.list-customers",
        "summary": "List Customers",
        "description": "Retrieves customers from ReputationLync.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/reputationLync/latest/actions/list-customers"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "required": false,
            "description": "Return a specific customer by ReputationLync customer ID.",
            "schema": {
              "type": "string",
              "description": "Return a specific customer by ReputationLync customer ID.",
              "example": "824925"
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "required": false,
            "description": "Filter customers by location identifier.",
            "schema": {
              "type": "string",
              "description": "Filter customers by location identifier.",
              "example": "12345",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "createdAfterDate",
            "in": "query",
            "required": false,
            "description": "Only return customers created after this date.",
            "schema": {
              "type": "string",
              "description": "Only return customers created after this date.",
              "example": "2023-04-01 00:00:00",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "createdBeforeDate",
            "in": "query",
            "required": false,
            "description": "Only return customers created before this date.",
            "schema": {
              "type": "string",
              "description": "Only return customers created before this date.",
              "example": "2023-04-30 23:59:59",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "createdAfterId",
            "in": "query",
            "required": false,
            "description": "Only return customers created after this internal record ID.",
            "schema": {
              "type": "string",
              "description": "Only return customers created after this internal record ID.",
              "example": "824000",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "createdBeforeId",
            "in": "query",
            "required": false,
            "description": "Only return customers created before this internal record ID.",
            "schema": {
              "type": "string",
              "description": "Only return customers created before this internal record ID.",
              "example": "825000",
              "x-mindcloud-advanced": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "logId": {
                            "type": "number",
                            "description": "Provider log identifier for the request."
                          },
                          "result": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            },
                            "description": "Matched customer records returned by ReputationLync."
                          },
                          "resultCount": {
                            "type": "number",
                            "description": "Number of matched customer records returned in the result array."
                          },
                          "status": {
                            "type": "string",
                            "description": "Provider status for the list-customer request."
                          },
                          "userId": {
                            "type": "string",
                            "description": "ReputationLync user identifier associated with the request."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
