{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Imgflip Universal API",
    "version": "0.0.1",
    "description": "List popular Imgflip templates and create publicly accessible captioned images with a dedicated account."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/imgflip/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/imgflip/latest/actions/caption-image": {
      "post": {
        "operationId": "imgflip.caption-image",
        "summary": "Caption Image",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/imgflip/latest/actions/caption-image"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "templateId",
                  "text0",
                  "text1"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "templateId": {
                    "type": "string",
                    "description": "Template ID returned by List Popular Memes."
                  },
                  "text0": {
                    "type": "string",
                    "description": "Top caption text. Do not use with boxes."
                  },
                  "text1": {
                    "type": "string",
                    "description": "Bottom caption text. Do not use with boxes."
                  },
                  "font": {
                    "type": "string",
                    "description": "Optional font family. Imgflip defaults to impact."
                  },
                  "maxFontSize": {
                    "type": "number",
                    "description": "Optional maximum font size in pixels. Imgflip defaults to 50."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "page_url": {
                            "type": "string",
                            "description": "Public Imgflip image page URL."
                          },
                          "url": {
                            "type": "string",
                            "description": "Public generated image URL."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/imgflip/latest/actions/list-popular-memes": {
      "get": {
        "operationId": "imgflip.list-popular-memes",
        "summary": "List Popular Memes",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/imgflip/latest/actions/list-popular-memes"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Optional type: image, gif, or the documented comma-separated combination such as gif,image. Defaults to image.",
            "schema": {
              "type": "string",
              "description": "Optional type: image, gif, or the documented comma-separated combination such as gif,image. Defaults to image.",
              "enum": [
                "gif",
                "gif,image",
                "image"
              ],
              "default": "image"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "box_count": {
                            "type": "number",
                            "description": "Default caption-box count."
                          },
                          "captions": {
                            "type": "number",
                            "description": "Estimated all-time captions."
                          },
                          "height": {
                            "type": "number",
                            "description": "Template height in pixels."
                          },
                          "id": {
                            "type": "string",
                            "description": "Imgflip template ID."
                          },
                          "name": {
                            "type": "string",
                            "description": "Template name."
                          },
                          "url": {
                            "type": "string",
                            "description": "Template image URL."
                          },
                          "width": {
                            "type": "number",
                            "description": "Template width in pixels."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
