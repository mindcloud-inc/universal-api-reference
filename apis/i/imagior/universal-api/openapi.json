                  "connectionId",
                  "templateId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "templateId": {
                    "type": "string",
                    "description": "The unique ID of the design template to use for image generation."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
