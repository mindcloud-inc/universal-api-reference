                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "details": {
                            "type": "object",
                            "additionalProperties": true,
                            "description": "Generated image metadata."
                          },
                          "imageURL": {
                            "type": "string",
                            "description": "URL of the generated image."
                          },
                          "message": {
                            "type": "string",
                            "description": "Generation result message."
                          },
                          "requestCompletionTime": {
                            "type": "string",
                            "description": "Time it took to complete the request."
                          },
                          "status": {
                            "type": "string",
                            "description": "Indicates whether the request was successful."
                          },
                          "statusCode": {
                            "type": "number",
                            "description": "HTTP-style success code returned by Imagior."
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When the request completed."
                          },
                          "usage": {
                            "type": "object",
