  "paths": {
    "/v1/universal/nova/latest/actions/add-lead": {
      "post": {
        "operationId": "nova.add-lead",
        "summary": "Add Lead",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nova/latest/actions/add-lead"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "list_id",
                  "phone_number_concatenated"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "list_id": {
                    "type": "number",
                    "description": "Target Nova live list identifier.",
                    "example": 28,
                    "default": 28
                  },
                  "phone_number_concatenated": {
                    "type": "string",
                    "description": "Lead phone number. Nova docs also allow an array, but this action currently models the common single-number case.",
                    "example": "+33777777777",
                    "default": "+33777777777"
                  },
                  "firstname": {
                    "type": "string",
                    "description": "Lead first name.",
                    "example": "John"
                  },
                  "lastname": {
                    "type": "string",
                    "description": "Lead last name.",
                    "example": "Doe"
                  },
                  "email": {
                    "type": "string",
                    "description": "Lead email address.",
                    "example": "john.doe@example.com"
                  },
                  "origin_crm_id": {
                    "type": "string",
                    "description": "External lead identifier in your CRM.",
                    "example": "crm-123"
                  },
                  "statut": {
                    "type": "string",
                    "description": "Nova lead status label.",
                    "example": "Sans statut"
                  },
                  "assigned_to": {
                    "type": "string",
                    "description": "Nova user ID assigned to the lead.",
                    "example": "10537"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "access_id": {
                            "type": "string",
                            "description": "Nova access token for opening the created lead debug view."
                          },
                          "email": {
                            "type": "string",
                            "description": "Lead email address."
                          },
                          "firstname": {
                            "type": "string",
                            "description": "Lead first name."
                          },
                          "lastname": {
                            "type": "string",
                            "description": "Lead last name."
                          },
                          "list_id": {
                            "type": "number",
                            "description": "Nova list identifier where the lead was created."
                          },
                          "phone_number_concatenated": {
                            "type": "string",
                            "description": "Lead phone number stored in Nova."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
