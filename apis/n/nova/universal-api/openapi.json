    "/v1/universal/nova/latest/actions/update-lead": {
      "put": {
        "operationId": "nova.update-lead",
        "summary": "Update Lead",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nova/latest/actions/update-lead"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "origin_crm_id"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "origin_crm_id": {
                    "type": "string",
                    "description": "External CRM lead identifier used by Nova to locate the lead to update.",
                    "example": "crm-123",
                    "default": "crm-123"
                  },
                  "phone_number_concatenated": {
                    "type": "string",
                    "description": "Updated lead phone number.",
                    "example": "+33777777777"
                  },
                  "firstname": {
                    "type": "string",
                    "description": "Updated lead first name.",
                    "example": "John"
                  },
                  "lastname": {
                    "type": "string",
                    "description": "Updated lead last name.",
                    "example": "Doe"
                  },
                  "email": {
                    "type": "string",
                    "description": "Updated lead email address.",
                    "example": "john.doe@example.com"
                  },
                  "statut": {
                    "type": "string",
                    "description": "Updated Nova lead status label.",
                    "example": "Intéressé"
                  },
                  "assigned_to": {
                    "type": "string",
                    "description": "Updated Nova user ID assigned to the lead.",
                    "example": "10537"
                  },
                  "commentaire": {
                    "type": "string",
                    "description": "Updated lead comment.",
                    "example": "Lead contacted"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "result": {
                            "type": "string",
                            "description": "Raw textual result returned by Nova after the lead update request."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
