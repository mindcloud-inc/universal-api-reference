{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Nationalize_io Universal API",
    "version": "0.1.5",
    "description": "Predicts the likely nationality of a name using Nationalize.io's public statistical name-nationality API."
  },
  "servers": [
    {
      "url": "https://connect.mindcloud.co"
    }
  ],
  "externalDocs": {
    "url": "https://mindcloud.co/docs/universal/rest/nationalizeIo/latest"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/universal/nationalizeIo/latest/actions/predict-nationalities-for-names": {
      "get": {
        "operationId": "nationalizeIo.predict-nationalities-for-names",
        "summary": "Predict Nationalities for Names",
        "description": "Retrieves nationality predictions from Nationalize.io for up to 10 names.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nationalizeIo/latest/actions/predict-nationalities-for-names"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "names[]",
            "in": "query",
            "required": true,
            "description": "Names to classify in one request. Nationalize.io supports up to 10 names per batch using repeated name[] query parameters.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Names to classify in one request. Nationalize.io supports up to 10 names per batch using repeated name[] query parameters."
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "number",
                            "description": "Number of source records used for this name prediction."
                          },
                          "country": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "countryId": {
                                  "type": "string",
                                  "description": "ISO 3166-1 alpha-2 country code for the prediction."
                                },
                                "probability": {
                                  "type": "number",
                                  "description": "Probability score for the country prediction."
                                }
                              }
                            },
                            "description": "Ranked nationality probability entries returned for each name."
                          },
                          "name": {
                            "type": "string",
                            "description": "Input name used by Nationalize.io."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "The MindCloud API key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The API key or connection cannot access this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "The action failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/universal/nationalizeIo/latest/actions/predict-nationality-by-name": {
      "get": {
        "operationId": "nationalizeIo.predict-nationality-by-name",
        "summary": "Predict Nationality by Name",
        "description": "Retrieves nationality predictions from Nationalize.io for one name.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nationalizeIo/latest/actions/predict-nationality-by-name"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Last name, first name, or full name to classify. Nationalize.io recommends using a last name when available.",
            "schema": {
              "type": "string",
              "description": "Last name, first name, or full name to classify. Nationalize.io recommends using a last name when available.",
              "example": "johnson"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
