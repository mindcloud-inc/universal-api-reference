    "/v1/universal/nASAAPOD/latest/actions/get-apod-date-range": {
      "get": {
        "operationId": "nASAAPOD.get-apod-date-range",
        "summary": "Get APOD Date Range",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nASAAPOD/latest/actions/get-apod-date-range"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "description": "First APOD date in YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "First APOD date in YYYY-MM-DD."
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "Optional last APOD date in YYYY-MM-DD. NASA defaults it to today.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Optional last APOD date in YYYY-MM-DD. NASA defaults it to today."
            }
          },
          {
            "name": "thumbs",
            "in": "query",
            "required": false,
            "description": "When true, NASA includes thumbnail_url for video APODs.",
            "schema": {
              "type": "boolean",
              "description": "When true, NASA includes thumbnail_url for video APODs.",
              "default": false
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
