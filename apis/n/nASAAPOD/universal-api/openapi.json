              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "copyright": {
                            "type": "string",
                            "description": "Optional copyright holder; present when the item is not public domain."
                          },
                          "date": {
                            "type": "string",
                            "format": "date-time",
                            "description": "APOD date."
                          },
                          "explanation": {
                            "type": "string",
                            "description": "NASA's description of the APOD."
                          },
                          "hdurl": {
                            "type": "string",
                            "description": "Optional high-resolution image URL."
                          },
                          "media_type": {
                            "type": "string",
                            "description": "Media type, such as image or video."
                          },
                          "service_version": {
                            "type": "string",
                            "description": "APOD service version."
                          },
                          "thumbnail_url": {
                            "type": "string",
                            "description": "Optional video thumbnail URL when thumbs is requested."
                          },
                          "title": {
                            "type": "string",
                            "description": "APOD title."
                          },
                          "url": {
                            "type": "string",
                            "description": "Media URL."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": true
