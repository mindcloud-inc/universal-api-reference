  "paths": {
    "/v1/universal/nudgify/latest/actions/create-conversion": {
      "post": {
        "operationId": "nudgify.create-conversion",
        "summary": "Create Conversion",
        "description": "Creates conversion events in Nudgify.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nudgify/latest/actions/create-conversion"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "conversions[]",
                  "conversions[].date"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "conversions[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "One or more conversion events to send to Nudgify."
                  },
                  "conversions[].date": {
                    "type": "string",
                    "description": "UTC timestamp in `Y-m-d H:i:s` format."
                  },
                  "conversions[].email": {
                    "type": "string",
                    "description": "Email address tied to the conversion."
                  },
                  "conversions[].firstName": {
                    "type": "string",
                    "description": "First name to show in the nudge."
                  },
                  "conversions[].lastName": {
                    "type": "string",
                    "description": "Last name to show in the nudge."
                  },
                  "conversions[].ip": {
                    "type": "string",
                    "description": "IP address used for location fallback."
                  },
                  "conversions[].city": {
                    "type": "string",
                    "description": "City to show in the nudge."
                  },
                  "conversions[].state": {
                    "type": "string",
                    "description": "State or region to show in the nudge."
                  },
                  "conversions[].country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
