    "/v1/universal/nudgify/latest/actions/create-purchase": {
      "post": {
        "operationId": "nudgify.create-purchase",
        "summary": "Create Purchase",
        "description": "Creates purchase events in Nudgify.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nudgify/latest/actions/create-purchase"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId",
                  "orders[]",
                  "orders[].orderId",
                  "orders[].date"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "orders[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "One or more purchase events to send to Nudgify."
                  },
                  "orders[].orderId": {
                    "type": "number",
                    "description": "Integer order identifier for the purchase."
                  },
                  "orders[].date": {
                    "type": "string",
                    "description": "UTC timestamp in `Y-m-d H:i:s` format."
                  },
                  "orders[].email": {
                    "type": "string",
                    "description": "Email address tied to the purchase."
                  },
                  "orders[].firstName": {
                    "type": "string",
                    "description": "First name to show in the nudge."
                  },
                  "orders[].lastName": {
                    "type": "string",
                    "description": "Last name to show in the nudge."
                  },
                  "orders[].ip": {
                    "type": "string",
                    "description": "IP address used for location fallback."
                  },
                  "orders[].city": {
                    "type": "string",
                    "description": "City to show in the nudge."
                  },
                  "orders[].state": {
                    "type": "string",
                    "description": "State or region to show in the nudge."
                  },
                  "orders[].country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code."
                  },
                  "orders[].lineItems[]": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Optional line items attached to the purchase."
                  },
                  "orders[].lineItems[].itemId": {
                    "type": "number",
                    "description": "Item identifier for a purchased line item. Runtime validation required this to be an integer."
                  },
                  "orders[].lineItems[].itemVariationId": {
                    "type": "string",
                    "description": "Variation or SKU identifier for the line item."
                  },
                  "orders[].lineItems[].itemName": {
                    "type": "string",
                    "description": "Display name of the purchased item."
                  },
                  "orders[].lineItems[].itemLink": {
                    "type": "string",
                    "description": "Product page URL for the purchased item."
                  },
                  "orders[].lineItems[].imageUrl": {
                    "type": "string",
                    "description": "Image URL for the purchased item."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
