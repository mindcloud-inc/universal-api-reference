      "get": {
        "operationId": "nASAImageAndVideoLibrary.search-assets",
        "summary": "Search Assets",
        "description": "Finds assets in NASA Image and Video Library by search criteria.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nASAImageAndVideoLibrary/latest/actions/search-assets"
