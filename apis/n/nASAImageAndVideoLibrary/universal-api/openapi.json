                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "data": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                          "center": {
                                            "type": "string",
                                            "description": "NASA center associated with the asset."
                                          },
                                          "date_created": {
                                            "type": "string",
                                            "format": "date-time",
                                            "description": "Asset creation date returned by NASA."
                                          },
                                          "description": {
                                            "type": "string",
                                            "description": "Asset description."
                                          },
                                          "keywords": {
                                            "type": "array",
                                            "items": {
                                              "type": "string"
                                            },
                                            "description": "Keywords attached to the asset."
                                          },
                                          "location": {
                                            "type": "string",
                                            "description": "Location metadata for the asset."
                                          },
                                          "media_type": {
                                            "type": "string",
                                            "description": "Media type such as image, video, or audio."
                                          },
                                          "nasa_id": {
                                            "type": "string",
                                            "description": "NASA asset identifier."
                                          },
                                          "photographer": {
                                            "type": "string",
                                            "description": "Primary photographer name when present."
                                          },
                                          "title": {
                                            "type": "string",
                                            "description": "Asset title."
                                          }
                                        }
                                      },
                                      "description": "Metadata objects describing the album member."
                                    },
                                    "href": {
                                      "type": "string",
                                      "description": "Asset collection URL for one album member."
                                    },
                                    "links": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "additionalProperties": true
                                      },
                                      "description": "Preview and related asset links."
                                    }
                                  }
                                },
                                "description": "Album members returned for this page."
                              },
                              "links": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": true
                                },
                                "description": "Pagination links such as next or previous."
                              },
                              "metadata": {
                                "type": "object",
                                "properties": {
                                  "total_hits": {
                                    "type": "number",
                                    "description": "Total number of album members across all pages."
                                  }
                                },
                                "additionalProperties": false
                              },
                              "version": {
                                "type": "string",
                                "description": "Collection+JSON version returned by NASA."
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
