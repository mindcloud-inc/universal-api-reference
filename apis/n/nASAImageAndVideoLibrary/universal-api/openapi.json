      "get": {
        "operationId": "nASAImageAndVideoLibrary.get-album-contents",
        "summary": "Get Album Contents",
        "description": "Retrieves album contents from NASA Image and Video Library.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nASAImageAndVideoLibrary/latest/actions/get-album-contents"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "connectionId",
            "in": "query",
            "required": true,
            "description": "The MindCloud connection ID for this app.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "albumName",
            "in": "query",
            "required": true,
            "description": "The case-sensitive NASA album name to retrieve.",
            "schema": {
              "type": "string",
              "description": "The case-sensitive NASA album name to retrieve."
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number to retrieve. Starts at 1.",
            "schema": {
              "type": "number",
              "description": "Page number to retrieve. Starts at 1."
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated response fields to include.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "collection": {
                            "type": "object",
                            "properties": {
                              "href": {
                                "type": "string",
                                "description": "Canonical NASA URL for this album result page."
                              },
                              "items": {
                                "type": "array",
