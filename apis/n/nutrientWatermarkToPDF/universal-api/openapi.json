                  "connectionId",
                  "document",
                  "logo",
                  "instructions"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "The MindCloud connection ID for this app."
                  },
                  "document": {
                    "type": "string",
                    "description": "PDF file to watermark."
                  },
                  "logo": {
                    "type": "string",
                    "description": "Image file to use as the watermark."
                  },
                  "instructions": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Build instructions for an image watermark. The image key must match the Logo Image field.",
