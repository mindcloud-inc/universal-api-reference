    "/v1/universal/nutrientWatermarkToPDF/latest/actions/add-image-watermark-to-pdf": {
      "put": {
        "operationId": "nutrientWatermarkToPDF.add-image-watermark-to-pdf",
        "summary": "Add Image Watermark to PDF",
        "description": "Updates a PDF with an image watermark in Nutrient.",
        "externalDocs": {
          "url": "https://mindcloud.co/docs/universal/rest/nutrientWatermarkToPDF/latest/actions/add-image-watermark-to-pdf"
